{
  "description": "Continue explicitly registered Foretoken RSI work; leave other sessions unchanged.",
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$(git rev-parse --show-toplevel)/.agents/skills/rsi/scripts/continuation.py\" hook --harness codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$(git rev-parse --show-toplevel)/.agents/skills/rsi/scripts/continuation.py\" hook --harness codex"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$(git rev-parse --show-toplevel)/.agents/skills/rsi/scripts/continuation.py\" hook --harness codex"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$(git rev-parse --show-toplevel)/.agents/skills/rsi/scripts/continuation.py\" hook --harness codex"
          }
        ]
      }
    ]
  }
}
