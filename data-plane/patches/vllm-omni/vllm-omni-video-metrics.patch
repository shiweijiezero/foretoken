+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+
+"""Video-only observations; pipeline and diffusion timing remain with their existing owners."""
+
+from __future__ import annotations
+
+import asyncio
+import io
+from collections.abc import Iterator, Mapping, Sequence
+from contextlib import contextmanager
+from functools import wraps
+from numbers import Real
+from typing import Any
+
+from prometheus_client import Counter, Gauge, Histogram
+from vllm.logger import init_logger
+
+from vllm_omni.metrics import definitions as defs
+from vllm_omni.metrics.utils import count_video_frames
+
+logger = init_logger(__name__)
+
+_requests = Counter(
+    defs.VIDEO_GENERATION_REQUESTS,
+    "Video serving completions by outcome, including response encoding.",
+    defs.VIDEO_OUTCOME_LABELS,
+)
+_running = Gauge(
+    defs.VIDEO_REQUESTS_RUNNING,
+    "Video serving calls in flight, including internal waiting and response encoding.",
+    defs.VIDEO_LABELS,
+)
+_outputs = Counter(defs.VIDEO_OUTPUTS, "Video outputs prepared for a completed response.", defs.VIDEO_LABELS)
+_frames = Counter(defs.VIDEO_FRAMES_METRIC, "Frames prepared for completed video responses.", defs.VIDEO_LABELS)
+_pixels = Counter(
+    defs.VIDEO_PIXELS_METRIC, "Pixels across frames prepared for completed video responses.", defs.VIDEO_LABELS
+)
+_reference_tokens = Histogram(
+    defs.VIDEO_REFERENCE_TOKENS,
+    "Reference visual tokens consumed by a video request.",
+    defs.VIDEO_LABELS,
+    buckets=(0, 256, 512, 1024, 2048, 4096, 8192, 16384),
+)
+_reference_tokens_last = Gauge(
+    defs.VIDEO_REFERENCE_TOKENS_LAST,
+    "Reference visual tokens consumed by the most recently observed request.",
+    defs.VIDEO_LABELS,
+)
+_stage_duration = Histogram(
+    defs.VIDEO_STAGE_DURATION_S,
+    "Video encoding stages not covered by diffusion timing families, in seconds.",
+    defs.VIDEO_STAGE_LABELS,
+    buckets=defs.SECONDS_BUCKETS,
+)
+_stage_duration_last = Gauge(
+    defs.VIDEO_STAGE_DURATION_LAST_S, "Most recent video encoding stage duration in seconds.", defs.VIDEO_STAGE_LABELS
+)
+
+
+def normalize_video_task(raw_task: object, *, has_image: bool, has_video: bool, has_audio: bool) -> str:
+    """Bound video task labels to known tasks or reference-input categories."""
+    if isinstance(raw_task, str) and raw_task.lower() in {"fl2va", "ref2va", "t2v", "i2v", "v2v", "a2v"}:
+        return raw_task.lower()
+    if sum((has_image, has_video, has_audio)) > 1:
+        return "multimodal_to_video"
+    if has_video:
+        return "video_to_video"
+    if has_image:
+        return "image_to_video"
+    if has_audio:
+        return "audio_to_video"
+    return "text_to_video"
+
+
+def observe_video_request(method: Any) -> Any:
+    """Wrap the two video response formats with one request-metrics lifecycle."""
+
+    @wraps(method)
+    async def observed(serving: Any, request: Any, *args: Any, **kwargs: Any) -> Any:
+        config = serving._resolve_diffusion_od_config()
+        task = normalize_video_task(
+            (request.extra_params or {}).get("task", getattr(config, "task_type", None)),
+            has_image=kwargs.get("reference_image") is not None,
+            has_video=kwargs.get("reference_video") is not None,
+            has_audio=kwargs.get("reference_audio") is not None,
+        )
+        with serving._video_metrics.track_request(task):
+            return await method(serving, request, *args, **kwargs)
+
+    return observed
+
+
+def _video_dimensions(video: object) -> tuple[int, int] | None:
+    """Read returned frame or MP4 header dimensions without decoding or copying frames."""
+    if isinstance(video, (bytes, bytearray, memoryview)):
+        import av
+
+        try:
+            with av.open(io.BytesIO(video)) as container:
+                if not container.streams.video:
+                    return None
+                codec = container.streams.video[0].codec_context
+                return codec.height, codec.width
+        except av.error.FFmpegError as exc:
+            logger.warning("Video pixel-count metadata is unavailable: %s", exc)
+            return None
+    if isinstance(video, (list, tuple)) and video:
+        first = video[0]
+        if hasattr(first, "height") and hasattr(first, "width"):
+            return int(first.height), int(first.width)
+        if (shape := getattr(first, "shape", None)) is not None and len(shape) == 3:
+            return (int(shape[0]), int(shape[1])) if shape[-1] in (1, 3, 4) else (int(shape[1]), int(shape[2]))
+    shape = getattr(video, "shape", None)
+    if shape is not None and len(shape) == 4:
+        if shape[-1] in (1, 3, 4):
+            return int(shape[1]), int(shape[2])
+        return int(shape[2]), int(shape[3])
+    return None
