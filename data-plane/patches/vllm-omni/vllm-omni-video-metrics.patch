+class OmniVideoMetrics:
+    """Publish video signals once in the API process, not once per GPU rank."""
+
+    def __init__(self, model_name: str) -> None:
+        self._model_name = model_name
+
+    @contextmanager
+    def track_request(self, task: str) -> Iterator[None]:
+        """Count one response-building attempt and restore its running gauge on every exit."""
+        labels = {"model_name": self._model_name, "task": task}
+        for outcome in ("success", "error", "cancelled", "client_error"):
+            _requests.labels(**labels, outcome=outcome)
+        for counter in (_outputs, _frames, _pixels):
+            counter.labels(**labels)
+        # Establish zero-count baselines before long requests so rate-based means
+        # include the first completion. Last-value gauges remain unbound until observed.
+        _reference_tokens.labels(**labels)
+        for stage in ("text_encode", "media_encode", "response_encode"):
+            _stage_duration.labels(**labels, stage=stage)
+        running = _running.labels(**labels)
+        running.inc()
+        outcome = "error"
+        try:
+            yield
+            outcome = "success"
+        except asyncio.CancelledError:
+            outcome = "cancelled"
+            raise
+        except Exception as exc:
+            status = getattr(exc, "status_code", None)
+            if isinstance(status, int) and 400 <= status < 500:
+                outcome = "client_error"
+            raise
+        finally:
+            running.dec()
+            _requests.labels(**labels, outcome=outcome).inc()
+
+    def observe_stage(self, task: str, stage: str, duration_s: float) -> None:
+        """Publish one of the bounded video encoding stages as histogram and last value."""
+        labels = {"model_name": self._model_name, "task": task, "stage": stage}
+        _stage_duration.labels(**labels).observe(duration_s)
+        _stage_duration_last.labels(**labels).set(duration_s)
+
+    def observe_outputs(
+        self, task: str, *, videos: Sequence[object], metadata: Mapping[str, Any], stage_durations: Mapping[str, float]
+    ) -> None:
+        """Observe actual returned media shapes and scalar conditioning metadata without copying tensors."""
+        labels = {"model_name": self._model_name, "task": task}
+        conditioning = metadata.get("conditioning", {})
+        reference_tokens = conditioning.get("reference_visual_tokens") if isinstance(conditioning, Mapping) else None
+        if isinstance(reference_tokens, Real) and reference_tokens >= 0:
+            _reference_tokens.labels(**labels).observe(reference_tokens)
+            _reference_tokens_last.labels(**labels).set(reference_tokens)
+        for stage, suffix in (("text_encode", ".encode_prompt"), ("media_encode", "._encode_local_media")):
+            durations = [value for name, value in stage_durations.items() if name.endswith(suffix)]
+            if durations:
+                self.observe_stage(task, stage, sum(durations))
+        for video in videos:
+            if isinstance(video, dict):
+                continue  # Action-only output is not a generated video.
+            _outputs.labels(**labels).inc()
+            frames = count_video_frames(video)
+            if frames is None and isinstance(video, (bytes, bytearray, memoryview)):
+                from vllm_omni.diffusion.utils.media_utils import count_mp4_frames
+
+                frames = count_mp4_frames(bytes(video))
+            if frames is not None:
+                _frames.labels(**labels).inc(frames)
+            dimensions = _video_dimensions(video)
+            if dimensions is not None and frames is not None:
+                _pixels.labels(**labels).inc(frames * dimensions[0] * dimensions[1])
