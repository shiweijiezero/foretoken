+    def query_prefix(
+        self, request: "Request", local_tokens: int
+    ) -> list[dict[str, str | int]]:
+        """Collect native offload observations without assigning a request to a child."""
+        from vllm.distributed.kv_transfer.kv_connector.v1.offloading_connector import (
+            OffloadingConnector,
+        )
+
+        observations: list[dict[str, str | int]] = []
+        for connector in self._connectors:
+            if isinstance(connector, (OffloadingConnector, MultiConnector)):
+                observations.extend(connector.query_prefix(request, local_tokens))
+        return observations
