+    def query_prefix(
+        self,
+        request: Request,
+        local_tokens: int,
+        max_num_new_tokens: int | None = None,
+    ) -> list[dict[str, str | int]]:
+        """Observe native offload prefixes without reserving cache capacity."""
+        if request.skip_reading_prefix_cache:
+            return []
+        if isinstance(self.manager, TieringOffloadingManager):
+            primary = self.manager.primary_tier
+            secondary_tiers = self.manager.secondary_tiers
+        elif isinstance(self.manager, CPUOffloadingManager):
+            primary = self.manager
+            secondary_tiers = ()
+        else:
+            return []
+
+        # Reuse native hashing, group keys, and the layout convergence algorithm.
+        # Only this temporary request state changes; the active scheduler and tiers do not.
+        context = _create_req_context(request)
+        state = RequestOffloadState(
+            self.config, request, context, RequestOffloadingContext()
+        )
+        state.num_locally_computed_tokens = local_tokens
+        state.update_offload_keys()
+        # A full native load still recomputes the last prompt token for sampling.
+        max_prefix_tokens = request.num_tokens - 1
+        cpu_tokens = self._query_prefix_match(state, primary.peek, max_num_new_tokens)
+        observations: list[dict[str, str | int]] = []
+        if cpu_tokens is not None and cpu_tokens > 0:
+            observations.append(
+                {
+                    "tier": "host_pinned",
+                    "matched_tokens": min(local_tokens + cpu_tokens, max_prefix_tokens),
+                }
+            )
+
+        filesystem_tiers = [
+            tier
+            for tier in secondary_tiers
+            if isinstance(tier, FileSystemTierManager)
+            and context.load_tier_filter.allows(tier.medium, tier.locality)
+        ]
+        if not filesystem_tiers:
+            return observations
+        if self.config.supports_partial_tail:
+            keys = [
+                make_offload_key(block_hash, group.group_idx)
+                for group in self.config.kv_group_configs
+                for block_hash in request.block_hashes[
+                    local_tokens // self.config.tokens_per_hash :
+                ]
+            ]
+        else:
+            keys = [
+                key
+                for group, group_state in zip(
+                    self.config.kv_group_configs, state.group_states
+                )
+                for key in group_state.offload_keys[
+                    local_tokens // group.tokens_per_chunk :
+                ]
+            ]
+        disk_keys: set[OffloadKey] = set()
+        for tier in filesystem_tiers:
+            disk_keys.update(tier.peek(keys, context))
+
+        def lookup(key: OffloadKey, req_context: ReqContext) -> LookupResult:
+            result = primary.peek(key, req_context)
+            if result is LookupResult.MISS and key in disk_keys:
+                return LookupResult.HIT
+            return result
+
+        # Disk is a continuation through the CPU staging tier, not an independent
+        # prefix whose length can be added to the GPU or CPU hit.
+        disk_tokens = self._query_prefix_match(state, lookup, max_num_new_tokens)
+        if disk_tokens is not None and disk_tokens > (cpu_tokens or 0):
+            observations.append(
+                {
+                    "tier": "disk",
+                    "matched_tokens": min(
+                        local_tokens + disk_tokens, max_prefix_tokens
+                    ),
+                }
+            )
+        return observations
+
