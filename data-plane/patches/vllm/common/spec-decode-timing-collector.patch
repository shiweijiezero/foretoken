+
+"""Completed speculative GPU stage samples shared by workers and engine stats."""
+
+from dataclasses import dataclass, field
+
+
+@dataclass
+class SpecDecodeTiming:
+    """GPU timeline durations for a complete speculative step on its output rank."""
+
+    target_forward_seconds: float
+    draft_seconds: float
+
+
+@dataclass
+class SpecDecodeTimingResult:
+    """Completed samples and whether the worker still owns unfinished events."""
+
+    samples: list[SpecDecodeTiming] = field(default_factory=list)
+    pending: bool = False
