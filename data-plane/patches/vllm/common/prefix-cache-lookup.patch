     @classmethod
+    def for_prefix_cache_lookup(
+        cls,
+        prompt_token_ids: list[int],
+        block_hasher: Callable[["Request"], list["BlockHash"]] | None,
+        cache_salt: str | None = None,
+        lora_name: str | None = None,
+        mm_features: list[dict[str, Any]] | None = None,
+        lora_path: str | None = None,
+    ) -> "Request":
+        """Build an unscheduled cache-identity request for prefix observers.
+
+        Uses native hashing without processing tensors, loading adapters, or
+        changing scheduler state. Multimodal inputs carry identifier and
+        placeholder offset/length only.
+        """
+        from vllm.lora.request import LoRARequest
+
+        lora_request = None
+        if lora_name is not None:
+            if lora_path is None:
+                raise ValueError("LoRA prefix lookup requires the adapter path")
+            lora_request = LoRARequest(lora_name, 1, lora_path=lora_path)
+
+        features = [
+            MultiModalFeatureSpec(
+                data=None,
+                modality="",
+                identifier=feature["identifier"],
+                mm_position=PlaceholderRange(
+                    offset=feature["offset"], length=feature["length"]
+                ),
+            )
+            for feature in mm_features or []
+        ]
+        return cls(
+            request_id="prefix-cache-lookup",
+            prompt_token_ids=prompt_token_ids,
+            sampling_params=SamplingParams(max_tokens=1),
+            pooling_params=None,
+            cache_salt=cache_salt,
+            lora_request=lora_request,
+            mm_features=features,
+            block_hasher=block_hasher,
+        )
+
