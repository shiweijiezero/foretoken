+    def get_prefix_cache_hit(
+        self,
+        prompt_token_ids: list[int],
+        cache_salt: str | None = None,
+        lora_name: str | None = None,
+        mm_features: list[dict[str, Any]] | None = None,
+        lora_path: str | None = None,
+    ) -> dict[str, Any]:
+        """Return this DP rank's local and offloaded reuse for routing observers.
+
+        This snapshot neither schedules nor reserves cache blocks. The native
+        coordinator reconciles all cache groups at the generation boundary.
+        """
+        request = Request.for_prefix_cache_lookup(
+            prompt_token_ids,
+            self.request_block_hasher,
+            cache_salt,
+            lora_name,
+            mm_features,
+            lora_path,
+        )
+        manager = self.scheduler.kv_cache_manager
+        matched_tokens = 0
+        if request.num_tokens > 1 and manager.prefix_cache_lookup_enabled(request):
+            _, matched_tokens, _ = manager.coordinator.find_longest_cache_hit(
+                request.block_hashes, request.num_tokens - 1
+            )
+        offloaded: list[dict[str, Any]] = []
+        connector = self.scheduler.get_kv_connector()
+        if request.num_tokens > 1 and connector is not None:
+            from vllm.distributed.kv_transfer.kv_connector.v1.multi_connector import (
+                MultiConnector,
+            )
+            from vllm.distributed.kv_transfer.kv_connector.v1.offloading_connector import (
+                OffloadingConnector,
+            )
+
+            if isinstance(connector, (OffloadingConnector, MultiConnector)):
+                offloaded = connector.query_prefix(request, matched_tokens)
+        return {
+            "dp_rank": self.engine_index,
+            "matched_tokens": matched_tokens,
+            "offloaded": offloaded,
+        }
