+    def claim_send_lease(self, req_id: str, lease_id: str, consumer_id: str) -> bool:
+        """Pin an available native source through the scheduler's collective RPC."""
+        return asyncio.run_coroutine_threadsafe(
+            self._change_send_lease(req_id, lease_id, consumer_id, claim=True),
+            self.sender_loop,
+        ).result()
+
+    def cancel_send_lease(self, req_id: str, lease_id: str, consumer_id: str) -> bool:
+        """Revoke a source once no admitted reader can still write."""
+        return asyncio.run_coroutine_threadsafe(
+            self._change_send_lease(req_id, lease_id, consumer_id, claim=False),
+            self.sender_loop,
+        ).result()
