+    async def _change_send_lease(
+        self, req_id: str, lease_id: str, consumer_id: str, *, claim: bool
+    ) -> bool:
+        """Serialize source acquisition and revocation with native submissions."""
+        send_meta = self.reqs_need_send.get(req_id)
+        if send_meta is None:
+            return not claim
+        if not send_meta.retained or not send_meta.ready.is_set():
+            return False
+        if claim:
+            if send_meta.read_lease is not None:
+                return (send_meta.read_lease, send_meta.consumer_id) == (
+                    lease_id,
+                    consumer_id,
