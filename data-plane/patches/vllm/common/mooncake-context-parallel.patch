+    def _handshake_target_ranks(self, remote_tp_size: int) -> list[int]:
+        """Map heterogeneous TP peers within the current DCP shard."""
+        if self.pcp_size != 1 or self.dcp_size <= 1:
+            return self.transfer_topo.handshake_target_ranks(remote_tp_size)
+        assert self.tp_size % self.dcp_size == 0
+        assert remote_tp_size % self.dcp_size == 0
+        local_group_size = self.tp_size // self.dcp_size
+        remote_group_size = remote_tp_size // self.dcp_size
+        local_group_rank = self.tp_rank // self.dcp_size
+        tp_ratio = _get_tp_ratio(local_group_size, remote_group_size)
+        if tp_ratio > 0:
+            remote_group_ranks = [local_group_rank // tp_ratio]
+        else:
+            ratio_abs = -tp_ratio
+            remote_group_ranks = [local_group_rank * ratio_abs + i for i in range(ratio_abs)]
+        return [rank * self.dcp_size + self.dcp_rank for rank in remote_group_ranks]
 
