+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+use std::collections::{BTreeSet, VecDeque};
+
+use vllm_parser::unified::TokenDisposition;
+use vllm_text::{DecodedLogprobs, DecodedPositionLogprobs};
+use vllm_tokenizer::TokenAttribution;
+
+use super::{AssistantEvent, ChatTokenMetadataMode};
+
+struct SampleMetadata {
+    token_id: u32,
+    logprobs: Option<DecodedPositionLogprobs>,
+}
+
+struct PendingSample {
+    payload: Option<SampleMetadata>,
+    covered_bytes: usize,
+    ready: bool,
+}
+
+/// Joins sampled metadata with complete parser-owned source coverage.
+/// Excluded payloads are released immediately; unresolved samples alone retain data.
+pub(super) struct PendingMetadata {
+    mode: ChatTokenMetadataMode,
+    next_position: usize,
+    pending: VecDeque<PendingSample>,
+}
+
+impl PendingMetadata {
+    pub(super) fn new(mode: ChatTokenMetadataMode) -> Self {
+        Self {
+            mode,
+            next_position: 0,
+            pending: VecDeque::new(),
+        }
+    }
+
+    /// Registers samples before the decoder/parser can refer to their positions.
+    /// Raw mode returns the existing event without allocating a pending queue.
+    pub(super) fn push_samples(
+        &mut self,
+        token_ids: Vec<u32>,
+        logprobs: Option<DecodedLogprobs>,
+    ) -> Option<AssistantEvent> {
+        self.next_position += token_ids.len();
+        if self.mode == ChatTokenMetadataMode::Sampled {
+            return (logprobs.is_some() || !token_ids.is_empty()).then_some(
+                AssistantEvent::LogprobsDelta {
+                    token_ids,
+                    logprobs,
+                },
+            );
+        }
+        let mut rows = logprobs.map(|logprobs| logprobs.positions.into_iter());
+        self.pending.extend(token_ids.into_iter().map(|token_id| PendingSample {
+            payload: Some(SampleMetadata {
+                token_id,
+                logprobs: rows.as_mut().and_then(Iterator::next),
+            }),
+            covered_bytes: 0,
+            ready: false,
+        }));
+        None
+    }
+
+    /// Applies one coverage fragment; any non-visible fragment excludes its whole sample.
+    pub(super) fn apply(&mut self, disposition: TokenDisposition) {
+        if self.mode == ChatTokenMetadataMode::Sampled {
+            return;
+        }
+        let first_position = self.next_position - self.pending.len();
+        let Some(index) = disposition.position.checked_sub(first_position) else {
+            // Later fragments of an already-excluded sample carry no payload.
+            return;
+        };
+        let sample = &mut self.pending[index];
+        if sample.payload.is_none() {
+            return;
+        }
+        if !disposition.visible || disposition.token_byte_count == 0 {
+            sample.payload = None;
+            sample.ready = true;
+            return;
+        }
+        sample.covered_bytes += disposition.covered_bytes;
+        sample.ready = sample.covered_bytes == disposition.token_byte_count;
+    }
+
+    /// Joins Harmony's token/channel decisions across each actual UTF-8 decode group.
+    /// Members share fragment ranges, including when one group spans several updates.
+    pub(super) fn apply_decoded_groups(&mut self, attributions: Vec<TokenAttribution>) {
+        if self.mode == ChatTokenMetadataMode::Sampled {
+            return;
+        }
+        let first_position = self.next_position - self.pending.len();
+        let mut excluded_groups = BTreeSet::new();
+        for attribution in &attributions {
+            let excluded = attribution.position < first_position
+                || self.pending[attribution.position - first_position].payload.is_none();
+            if excluded {
+                excluded_groups.insert((
+                    attribution.byte_range.start,
+                    attribution.byte_range.end,
+                    attribution.token_byte_count,
+                ));
+            }
+        }
+        for attribution in attributions {
+            let visible = !excluded_groups.contains(&(
+                attribution.byte_range.start,
+                attribution.byte_range.end,
+                attribution.token_byte_count,
+            ));
+            self.apply(TokenDisposition {
+                position: attribution.position,
+                covered_bytes: attribution.byte_range.len(),
+                token_byte_count: attribution.token_byte_count,
+                visible,
+            });
+        }
+    }
+
+    /// Drops unclassified parser state on fallback while preserving completed decisions.
+    pub(super) fn discard_unresolved(&mut self) {
+        for sample in &mut self.pending {
+            if !sample.ready {
+                sample.payload = None;
+                sample.ready = true;
+            }
+        }
+    }
+
+    /// Releases the resolved prefix in sampled order, never waiting for stream completion.
+    pub(super) fn take_ready(&mut self) -> Vec<AssistantEvent> {
+        let mut events = Vec::new();
+        while self.pending.front().is_some_and(|sample| sample.ready) {
+            let Some(payload) = self.pending.pop_front().unwrap().payload else {
+                continue;
+            };
+            match events.last_mut() {
+                Some(AssistantEvent::LogprobsDelta {
