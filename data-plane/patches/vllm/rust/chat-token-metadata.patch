+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+use std::collections::VecDeque;
+use std::mem::take;
+use std::ops::{Deref, Range};
+
+/// A generated sample's contribution to one decoded fragment.
+///
+/// Several samples can share one decoder-resolved UTF-8 group; its members
+/// have identical ranges and widths within each decoder output. Splitting
+/// clips each range without overlap, retaining the position and complete width.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct TokenAttribution {
+    /// Zero-based generated sample position; prompt tokens are not counted.
+    pub position: usize,
+    /// Coverage local to the enclosing decoded fragment.
+    pub byte_range: Range<usize>,
+    /// Complete decoder-group width before slicing or stop-string truncation.
+    pub token_byte_count: usize,
+}
+
+/// Decoded text with source-sample coverage retained across parser slicing.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct DecodedText {
+    pub text: String,
+    pub attributions: Vec<TokenAttribution>,
+}
+
+impl DecodedText {
+    /// Creates text without generated-sample metadata for non-decoder callers.
+    pub fn unattributed(text: impl Into<String>) -> Self {
+        Self {
+            text: text.into(),
+            attributions: Vec::new(),
+        }
+    }
+
+    /// Reports whether this fragment has neither text nor sample coverage.
+    pub fn is_empty(&self) -> bool {
+        self.text.is_empty() && self.attributions.is_empty()
+    }
+
+    /// Transfers a fragment and its coverage to its consumer.
+    pub fn take(&mut self) -> Self {
+        take(self)
+    }
+
+    /// Releases buffered text and source coverage while retaining capacity.
+    pub fn clear(&mut self) {
+        self.text.clear();
+        self.attributions.clear();
+    }
+
+    /// Removes a prefix, splitting crossing sample coverage between both pieces.
+    pub fn drain_prefix(&mut self, len: usize) -> Self {
+        let text = self.text.drain(..len).collect();
+        let mut prefix = Self {
+            text,
+            attributions: Vec::new(),
+        };
+        for mut attribution in take(&mut self.attributions) {
+            let start = attribution.byte_range.start;
+            let end = attribution.byte_range.end;
+            if end <= len {
+                prefix.attributions.push(attribution);
+            } else if start >= len {
+                attribution.byte_range = start - len..end - len;
+                self.attributions.push(attribution);
+            } else {
+                prefix.attributions.push(TokenAttribution {
+                    position: attribution.position,
+                    byte_range: start..len,
+                    token_byte_count: attribution.token_byte_count,
+                });
+                attribution.byte_range = 0..end - len;
+                self.attributions.push(attribution);
+            }
+        }
+        prefix
+    }
+
+    /// Appends a fragment and rebases its local sample coverage.
+    pub fn append(&mut self, mut other: Self) {
+        let offset = self.text.len();
+        self.text.push_str(&other.text);
+        for attribution in &mut other.attributions {
+            attribution.byte_range.start += offset;
+            attribution.byte_range.end += offset;
+        }
+        self.attributions.extend(other.attributions);
+    }
+}
+
+impl Deref for DecodedText {
+    type Target = str;
+
+    fn deref(&self) -> &str {
+        &self.text
+    }
+}
+
+impl From<&str> for DecodedText {
+    fn from(text: &str) -> Self {
+        Self::unattributed(text)
+    }
+}
+
+impl From<String> for DecodedText {
+    fn from(text: String) -> Self {
+        Self::unattributed(text)
+    }
+}
+
+struct PendingAttribution {
+    position: usize,
+    byte_range: Option<Range<usize>>,
+    token_byte_count: usize,
+    emitted: bool,
+}
+
+/// Decoder-owned pending coverage; emitted records are released incrementally.
+#[derive(Default)]
+pub(super) struct AttributedTextBuffer {
+    text: String,
+    emitted_byte_offset: usize,
+    next_position: usize,
+    pending_start: Option<usize>,
+    attributions: VecDeque<PendingAttribution>,
+}
+
+impl AttributedTextBuffer {
+    pub(super) fn text(&self) -> &str {
+        &self.text
+    }
+
+    pub(super) fn len(&self) -> usize {
+        self.text.len()
+    }
+
+    /// Registers one generated sample before its decoded bytes are known.
+    pub(super) fn record_pending_token(&mut self) {
+        self.pending_start.get_or_insert(self.next_position);
+        self.attributions.push_back(PendingAttribution {
+            position: self.next_position,
+            byte_range: None,
+            token_byte_count: 0,
+            emitted: false,
+        });
+        self.next_position += 1;
+    }
+
+    /// Registers a skipped special token without attributing a later token's text.
+    pub(super) fn record_zero_width_token(&mut self) {
+        self.attributions.push_back(PendingAttribution {
+            position: self.next_position,
+            byte_range: Some(self.text.len()..self.text.len()),
+            token_byte_count: 0,
+            emitted: false,
+        });
+        self.next_position += 1;
+    }
+
+    /// Resolves pending samples as one actual decoder-produced text group.
+    pub(super) fn append_visible_text(&mut self, text: &str) {
+        if text.is_empty() {
+            return;
+        }
+        let start = self.text.len();
+        let end = start + text.len();
+        if let Some(position) = self.pending_start.take() {
+            let index = position - self.attributions.front().unwrap().position;
+            for attribution in self.attributions.range_mut(index..) {
+                if attribution.byte_range.is_none() {
+                    attribution.byte_range = Some(start..end);
+                    attribution.token_byte_count = text.len();
+                }
+            }
+        }
+        self.text.push_str(text);
+    }
+
+    /// Resolves samples that still produced no decoded bytes at termination.
+    pub(super) fn resolve_pending_zero_width(&mut self) {
+        let Some(position) = self.pending_start.take() else {
+            return;
+        };
+        let index = position - self.attributions.front().unwrap().position;
+        for attribution in self.attributions.range_mut(index..) {
+            if attribution.byte_range.is_none() {
+                attribution.byte_range = Some(self.text.len()..self.text.len());
+            }
+        }
+    }
+
+    /// Truncates text without making a partially retained token a complete token.
+    pub(super) fn truncate(&mut self, byte_offset: usize) {
+        self.text.truncate(byte_offset);
+        self.attributions.retain_mut(|attribution| {
+            if let Some(range) = &mut attribution.byte_range {
+                if range.start > byte_offset
+                    || (range.start == byte_offset && attribution.token_byte_count != 0)
+                {
+                    return false;
+                }
+                range.end = range.end.min(byte_offset);
+            }
+            true
+        });
+    }
+
+    /// Emits ready text and coverage fragments, retaining only unfinished records.
+    pub(super) fn take_ready(&mut self, cutoff: usize) -> Option<DecodedText> {
+        let chunk_start = self.emitted_byte_offset;
+        let mut attributions = Vec::new();
+        for attribution in &mut self.attributions {
+            if attribution.emitted {
+                continue;
+            }
+            let Some(range) = &mut attribution.byte_range else {
+                continue;
+            };
+            if range.start > cutoff || (range.start == cutoff && attribution.token_byte_count != 0)
+            {
+                continue;
+            }
+            let end = range.end.min(cutoff);
+            attributions.push(TokenAttribution {
+                position: attribution.position,
+                byte_range: range.start - chunk_start..end - chunk_start,
+                token_byte_count: attribution.token_byte_count,
+            });
+            range.start = end;
+            attribution.emitted = range.start == range.end;
+        }
+        while self.attributions.front().is_some_and(|record| record.emitted) {
+            self.attributions.pop_front();
+        }
+        if cutoff == chunk_start && attributions.is_empty() {
+            return None;
+        }
+        let text = self.text[chunk_start..cutoff].to_string();
+        self.emitted_byte_offset = cutoff;
+        Some(DecodedText { text, attributions })
+    }
+
+    /// Returns unconsumed coverage and the existing cumulative text result.
+    pub(super) fn finish(&mut self) -> (Option<DecodedText>, String) {
+        let last = self.take_ready(self.text.len());
+        self.attributions.clear();
+        self.emitted_byte_offset = 0;
+        (last, take(&mut self.text))
+    }
+}
