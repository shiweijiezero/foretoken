+    /// Admit requests in one operation per routed engine, retaining native per-request streams.
+    /// An optional worker RPC prepares inputs on each participating engine before admission.
+    /// Requires EngineCore's `add_requests` utility; streams are returned in input order.
+    pub async fn call_batch<A>(
+        &self,
+        requests: Vec<EngineCoreRequest>,
+        worker_rpc: Option<(&str, A)>,
+    ) -> Result<Vec<EngineCoreOutputStream>>
+    where
+        A: serde::Serialize + std::fmt::Debug,
+    {
+        let mut registrations = Vec::with_capacity(requests.len());
+        let mut batches: BTreeMap<EngineId, Vec<Vec<OpaqueValue>>> = BTreeMap::new();
+        let snapshot = self.coordinator.as_ref().map(|coordinator| coordinator.snapshot());
+        let prepared: Result<()> = (|| {
+            for mut request in requests {
+                request.client_index = self.config.client_index;
+                request.validate()?;
+                if let Some(snapshot) = &snapshot {
+                    request.current_wave = snapshot.current_wave;
+                }
+                let request_id = request.request_id.clone();
+                let lora_name = request.lora_request.as_ref().map(|lora| lora.lora_name.clone());
+                let rank = request.data_parallel_rank;
+                let (payload, aux_frames) = self.inner.encode_request(request)?;
+                let (engine_id, rx) =
+                    self.inner.register_request(request_id.clone(), lora_name, rank)?;
+                let completion = match self.inner.request_completion(&request_id) {
+                    Ok(receiver) => RequestCompletion::new(request_id.clone(), receiver),
+                    Err(error) => {
+                        self.inner.rollback_request(&request_id);
+                        return Err(error);
+                    }
+                };
+                registrations.push((
+                    request_id,
+                    engine_id.engine_index().unwrap_or(0),
+                    rx,
+                    completion,
+                ));
+                let frames = std::iter::once(OpaqueValue::Binary(payload))
+                    .chain(aux_frames.into_iter().map(|frame| OpaqueValue::Binary(frame.to_vec())))
+                    .collect();
+                batches.entry(engine_id).or_default().push(frames);
+            }
+            if let Some(coordinator) = &self.coordinator {
+                if !snapshot.as_ref().unwrap().engines_running {
+                    for engine_id in batches.keys() {
+                        coordinator.notify_first_request(engine_id.clone())?;
+                    }
+                }
+            }
+            Ok(())
+        })();
+        if let Err(error) = prepared {
+            for (request_id, _, _, _) in &registrations {
+                self.inner.rollback_request(request_id);
+            }
+            return Err(error);
+        }
+        // Before submission, rollback must not queue Drop-driven aborts for IDs
+        // that another caller could register again. Streams own cancellation only
+        // after every request has been prepared successfully.
+        let streams = registrations
+            .into_iter()
+            .map(|(request_id, engine_index, rx, completion)| {
+                EngineCoreOutputStream::new(
+                    request_id,
+                    engine_index,
+                    self.abort_tx.clone(),
+                    rx,
+                    completion,
+                )
+            })
+            .collect();
+        let calls: Vec<_> = batches
+            .into_iter()
+            .map(|(engine, batch)| (engine, (batch, worker_rpc.as_ref())))
+            .collect();
+        // Registered streams stay owned until submission completes. On a send or
+        // admission error their ordinary drop path aborts any accepted requests.
+        self.call_utilities::<(), _>("add_requests", &calls).await?;
+        Ok(streams)
+    }
