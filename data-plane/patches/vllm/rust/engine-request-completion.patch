+/// Engine-origin termination observation independent of local stream completion or abort.
+/// Confirmation ends request scheduling; it does not synchronize the GPU or release connector KV.
+#[derive(Clone, Debug)]
+pub struct RequestCompletion {
+    request_id: String,
+    receiver: watch::Receiver<bool>,
+}
+
+impl RequestCompletion {
+    pub(crate) fn new(request_id: String, receiver: watch::Receiver<bool>) -> Self {
+        Self {
+            request_id,
+            receiver,
+        }
+    }
+
+    /// Waits for a terminal engine output or finished-request notification.
+    /// Transport loss and local cancellation never become successful confirmation.
+    pub async fn wait(&self) -> Result<()> {
+        let mut receiver = self.receiver.clone();
+        loop {
+            if *receiver.borrow_and_update() {
+                return Ok(());
+            }
+            receiver.changed().await.map_err(|_| Error::RequestStreamClosed {
+                request_id: self.request_id.clone(),
+            })?;
+        }
     }
 }
 
