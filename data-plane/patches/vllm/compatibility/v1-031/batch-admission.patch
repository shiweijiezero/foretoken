+    def add_requests(
+        self,
+        requests: list[tuple[Request, int]],
+        worker_rpc: tuple[str, tuple] | None = None,
+        admission: tuple[str, Any] | None = None,
+    ) -> bool | None:
+        """Scope optional scheduler preparation around worker setup and native admission."""
+        with ExitStack() as stack:
+            if admission is not None:
+                method, plan = admission
+                accepted = stack.enter_context(
+                    getattr(self.scheduler, method)(requests, plan)
+                )
+                if not accepted:
+                    return False
+            if worker_rpc is not None:
+                method, args = worker_rpc
+                self.model_executor.collective_rpc(method, args=args)
+            for request, request_wave in requests:
+                self.add_request(request, request_wave)
+            return True if admission is not None else None
+
