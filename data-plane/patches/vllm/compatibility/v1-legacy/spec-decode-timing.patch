+    def collect_spec_decode_timings(
+        self,
+    ) -> Future[list[SpecDecodeTimingResult | None]]:
+        # Use the model-output rank's FIFO: its timing reply precedes any newer
+        # model reply, without waiting for an unrelated rank's response thread.
+        future: FutureWrapper = self.collective_rpc(
+            "collect_spec_decode_timings",
+            unique_reply_rank=self.output_rank,
+            non_block=True,
+            pollable=True,
+            timeout=envs.VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS,
+        )
+        future.aggregate = lambda result: [result]
+        return future

