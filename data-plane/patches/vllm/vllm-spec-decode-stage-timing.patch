+@dataclass
+class SpecDecodeTiming:
+    # Per-step GPU timeline durations, measured on the output-producing rank.
+    target_forward_seconds: float
+    draft_seconds: float
+
+
+@dataclass
+class SpecDecodeTimingEvents:
+    target_start: torch.cuda.Event = field(
+        default_factory=lambda: torch.cuda.Event(enable_timing=True)
+    )
+    target_end: torch.cuda.Event = field(
+        default_factory=lambda: torch.cuda.Event(enable_timing=True)
+    )
+    draft_start: torch.cuda.Event = field(
+        default_factory=lambda: torch.cuda.Event(enable_timing=True)
+    )
+    draft_end: torch.cuda.Event = field(
+        default_factory=lambda: torch.cuda.Event(enable_timing=True, blocking=True)
+    )
+
+    def resolve(self) -> SpecDecodeTiming:
+        """Wait for this step's draft and read both GPU timeline durations."""
+        self.draft_end.synchronize()
+        return SpecDecodeTiming(
+            target_forward_seconds=self.target_start.elapsed_time(self.target_end)
+            / 1000,
+            draft_seconds=self.draft_start.elapsed_time(self.draft_end) / 1000,
+        )
+
+
