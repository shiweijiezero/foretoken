+class RpcFuture(Future):
+    """Gather ordinary RPC replies using Ray's own completion notifications."""
+
+    def __init__(self, references):
+        super().__init__()
+        self.worker_futures = [reference.future() for reference in references]
+        if not self.worker_futures:
+            self.set_result([])
+        for future in self.worker_futures:
+            future.add_done_callback(self._collect)
+
+    def _collect(self, completed):
+        if self.done():
+            return
+        try:
+            completed.result()
+            if not all(future.done() for future in self.worker_futures):
+                return
+            results = [future.result() for future in self.worker_futures]
+        except Exception as error:
+            with suppress(InvalidStateError):
+                self.set_exception(error)
+        else:
+            with suppress(InvalidStateError):
+                self.set_result(results)


 class FutureWrapper(Future):
