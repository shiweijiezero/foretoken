+#[cfg(test)]
+mod tests {
+    use std::collections::BTreeMap;
+
+    use rmpv::Value;
+
+    use super::EngineCoreReadyResponse;
+
+    // Protects startup with the three-field response emitted by vLLM 0.20 and 0.21.
+    #[test]
+    fn decodes_vllm_0_20_ready_response() {
+        let payload = rmp_serde::to_vec_named(&BTreeMap::from([
+            ("max_model_len", Value::from(4096)),
+            ("num_gpu_blocks", Value::from(1024)),
+            ("dp_stats_address", Value::Nil),
+        ]))
+        .unwrap();
+        let response: EngineCoreReadyResponse = rmp_serde::from_slice(&payload).unwrap();
+
+        assert_eq!(response.max_model_len, 4096);
+        assert_eq!(response.num_gpu_blocks, 1024);
+        assert!(response.dtype.is_none());
+        assert!(response.max_num_seqs.is_none());
+    }
+}
