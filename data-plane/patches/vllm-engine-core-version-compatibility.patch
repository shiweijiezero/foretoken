+    priority: i32,
+    trace_headers: &'a Option<BTreeMap<String, String>>,
+    resumable: bool,
+    external_req_id: &'a Option<String>,
+    reasoning_ended: &'a Option<bool>,
+}
+
+impl<'a> From<&'a EngineCoreRequest> for RequestV20<'a> {
