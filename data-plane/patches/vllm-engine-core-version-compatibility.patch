+/// Selects the positional EngineCore wire layout used by one vLLM release family.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum EngineCoreProtocol {
+    /// vLLM 0.20 places `client_index` directly after `prompt_embeds`.
+    V0_20,
+    /// vLLM 0.21 through 0.27 include `prompt_is_token_ids` before `client_index`.
+    V0_21ToV0_27,
+    /// vLLM 0.28 appends `session_id` to the request.
+    V0_28,
+}
+
+/// Encode legacy field layouts without copying request data or using intermediate dynamic values.
+#[derive(Debug)]
+struct VersionedRequest<'a> {
+    request: &'a EngineCoreRequest,
+    protocol: EngineCoreProtocol,
+}
+
+impl Serialize for VersionedRequest<'_> {
+    fn serialize<S: Serializer>(&self, serializer: S) -> std::result::Result<S::Ok, S::Error> {
+        if self.protocol == EngineCoreProtocol::V0_28 {
+            return self.request.serialize(serializer);
+        }
+        let request = self.request;
+        let legacy = self.protocol == EngineCoreProtocol::V0_20;
+        let mut fields = serializer.serialize_tuple(if legacy { 17 } else { 20 })?;
+        fields.serialize_element(&request.request_id)?;
+        fields.serialize_element(&request.prompt_token_ids)?;
+        fields.serialize_element(&request.mm_features)?;
+        fields.serialize_element(&request.sampling_params)?;
+        fields.serialize_element(&request.pooling_params)?;
+        fields.serialize_element(&request.arrival_time)?;
+        fields.serialize_element(&request.lora_request)?;
+        fields.serialize_element(&request.cache_salt)?;
+        fields.serialize_element(&request.data_parallel_rank)?;
+        fields.serialize_element(&request.prompt_embeds)?;
+        // v0.21 inserts a mask before client_index; truncating the current array is insufficient.
+        if !legacy {
+            fields.serialize_element(&request.prompt_is_token_ids)?;
+        }
+        fields.serialize_element(&request.client_index)?;
+        fields.serialize_element(&request.current_wave)?;
+        fields.serialize_element(&request.priority)?;
+        fields.serialize_element(&request.trace_headers)?;
+        fields.serialize_element(&request.resumable)?;
+        fields.serialize_element(&request.external_req_id)?;
+        fields.serialize_element(&request.reasoning_ended)?;
+        if !legacy {
+            fields.serialize_element(&request.reasoning_parser_kwargs)?;
+            fields.serialize_element(&request.abort_immediately)?;
+        }
+        fields.end()
+    }
+}
