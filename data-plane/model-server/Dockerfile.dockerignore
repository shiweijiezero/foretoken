# This Dockerfile-specific ignore file overrides the repository-root
# .dockerignore when building with `docker build -f data-plane/model-server/Dockerfile .`.
# Keep the root context small while retaining the vLLM Rust path dependencies.
**
!data-plane/
!data-plane/model-protocol/
!data-plane/model-protocol/**
!data-plane/model-server/
!data-plane/model-server/**
!third_party/
!third_party/vllm-rust/
!third_party/vllm-rust/source/
!third_party/vllm-rust/source/rust/
!third_party/vllm-rust/source/rust/**

# Never send local build products to the builder.
data-plane/model-server/target/
data-plane/model-server/.venv/
data-plane/model-server/**/__pycache__/
data-plane/model-server/**/*.py[cod]
third_party/vllm-rust/source/rust/target/
