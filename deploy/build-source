"""Compile application files through the same entrypoint in images and development Pods."""

from __future__ import annotations

import argparse
import filecmp
import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
import tomllib
import uuid
from pathlib import Path


def main() -> None:
    """Build requested application parts into a caller-owned publication directory."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("component", choices=("control-plane", "frontend", "model-server"))
    parser.add_argument("output", type=Path)
    parser.add_argument("--cache", type=Path, required=True)
    parser.add_argument("--parts", nargs="+", choices=("go", "rust", "python"))
    parser.add_argument("--workspace", type=Path)
    parser.add_argument("--versions", type=Path)
    parser.add_argument("--cache-export", type=Path, help="export native compiler state for subsequent workspaces")
    parser.add_argument("--cache-seed", type=Path, help="initialize a new workspace from an exported compiler cache")
    arguments = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    output = arguments.output.resolve()
    cache = arguments.cache.resolve()
    environment = os.environ.copy()
    if arguments.cache_seed is not None and arguments.workspace is None:
        parser.error("--cache-seed requires --workspace")
    if arguments.workspace is not None and arguments.versions is None:
        parser.error("--workspace requires --versions")
    # Capture supplied inputs before preparation materializes or patches dependencies.
    inputs = (
        application_inputs(json.loads(arguments.versions.read_text()), arguments.component)
        if arguments.versions is not None
        else source_inventory(root, arguments.component)
    ) if arguments.cache_export is not None else {}
    if arguments.workspace is not None:
        workspace = arguments.workspace.resolve()
        restore_cache(
            arguments.cache_seed.resolve() if arguments.cache_seed is not None else None,
            workspace, cache, environment, arguments.component,
        )
        root = prepare_workspace(root, workspace, arguments.versions, arguments.component)
    parts = set(arguments.parts or ({"go"} if arguments.component == "control-plane" else {"rust", "python"}))
    output.mkdir(parents=True, exist_ok=True)
    cache.mkdir(parents=True, exist_ok=True)

    if "go" in parts:
        compile_controller(root, output, cache, environment)
    if "rust" in parts:
        compile_rust(root, arguments.component, output, cache, environment)
    if arguments.component == "model-server" and "python" in parts:
        destination = output / "python"
        if destination.exists():
            shutil.rmtree(destination)
        shutil.copytree(root / "data-plane/model-server/python", destination)
    if arguments.component in {"control-plane", "model-server"}:
        shutil.copyfile(root / "LICENSE", output / "LICENSE")
    if arguments.cache_export is not None:
        export_cache(root, arguments.cache_export.resolve(), cache, environment, arguments.component, inputs)
    (output / "complete.json").write_text(json.dumps({"component": arguments.component}) + "\n")


def application_inputs(versions: dict[str, str], component: str) -> dict[str, str]:
    """Select the input inventory owned by one native application build."""
    prefix = "control-plane/" if component == "control-plane" else "data-plane/"
    return {
        name: version for name, version in versions.items()
        if name.startswith(prefix) or name in {"LICENSE", "deploy/build-source"}
    }


def source_exclusions(directory: str, names: list[str]) -> set[str]:
    """Keep source exports free of working-directory caches and version-control credentials."""
    return {
        name for name in names
        if name in {".git", ".venv", ".gpu_cache", ".cache", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", "target", ".env"}
        or name.startswith(".env.") or name.endswith((".pyc", ".pyo", ".egg-info", ".dist-info"))
    }


def source_inventory(root: Path, component: str) -> dict[str, str]:
    """Capture image-build inputs before upstream preparation generates additional source files."""
    revision = uuid.uuid4().hex
    versions = {name: revision for name in ("LICENSE", "deploy/build-source") if (root / name).is_file()}
    prefix = "control-plane" if component == "control-plane" else "data-plane"
    for directory, directories, files in os.walk(root / prefix):
        excluded = source_exclusions(directory, [*directories, *files])
        directories[:] = [name for name in directories if name not in excluded]
        for name in files:
            path = Path(directory) / name
            if name not in excluded and path.is_file():
                versions[str(path.relative_to(root))] = revision
    return versions


def prepare_workspace(source: Path, workspace: Path, versions: Path, component: str) -> Path:
    """Update a compiler's mutable source tree while preserving unchanged files and incremental outputs."""
    selected = application_inputs(json.loads(versions.read_text()), component)
    receipt = workspace.with_suffix(".json")
    previous = json.loads(receipt.read_text()) if receipt.is_file() else {}
    if previous == selected:
        return workspace
    receipt.unlink(missing_ok=True)
    if not previous:
        if workspace.exists():
            shutil.rmtree(workspace)
    elif component != "control-plane":
        # Automatically materialized dependencies follow the declaration. Supplied
        # source files are restored from the captured input, never changed in place.
        old = tomllib.loads((workspace / "data-plane/Cargo.toml").read_text())["workspace"]["metadata"]["foretoken"]
        new = tomllib.loads((source / "data-plane/Cargo.toml").read_text())["workspace"]["metadata"]["foretoken"]
        upstream = "data-plane/" + new["vllm_source"]
        if (
            any(old[key] != new[key] for key in ("vllm_source", "vllm_repository", "vllm_revision"))
            or any(name.startswith(upstream + "/rust/") for name in previous) != any(name.startswith(upstream + "/rust/") for name in selected)
        ):
            old_source = workspace / "data-plane" / old["vllm_source"]
            if old_source.exists():
                shutil.rmtree(old_source)
            previous = {name: version for name, version in previous.items() if not name.startswith(upstream + "/")}
    workspace.mkdir(parents=True, exist_ok=True)
    for name in sorted(previous.keys() - selected.keys(), reverse=True):
        target = workspace / name
        target.unlink(missing_ok=True)
        parent = target.parent
        while parent != workspace and parent.is_dir() and not any(parent.iterdir()):
            parent.rmdir()
            parent = parent.parent
    filecmp.clear_cache()
    for name, version in selected.items():
        if previous.get(name) == version:
            continue
        original = source / name
        target = workspace / name
        if (
            target.is_file()
            and (target.stat().st_mode & 0o111) == (original.stat().st_mode & 0o111)
            and filecmp.cmp(original, target, shallow=False)
        ):
            continue
        if target.is_dir():
            shutil.rmtree(target)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(original, target)
        target.touch()
    pending = receipt.with_suffix(".next")
    pending.write_text(json.dumps(selected) + "\n")
    pending.replace(receipt)
    return workspace


def export_cache(
    root: Path, destination: Path, cache: Path, environment: dict[str, str],
    component: str, inputs: dict[str, str],
) -> None:
    """Export one component's prepared source and native caches as a filesystem image payload."""
    destination.mkdir(parents=True)
    upstream = None
    if component != "control-plane":
        metadata = tomllib.loads((root / "data-plane/Cargo.toml").read_text())["workspace"]["metadata"]["foretoken"]
        upstream = Path("data-plane") / metadata["vllm_source"]
    for name in inputs:
        relative = Path(name)
        if upstream is not None and relative.is_relative_to(upstream):
            continue
        original = root / relative
        if original.is_file():
            target = destination / "source" / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(original, target)
    if upstream is not None:
        # Include the prepared source and patch receipt, not just the supplied inventory.
        shutil.copytree(root / upstream, destination / "source" / upstream, symlinks=True, ignore=source_exclusions)
        target = (root / "data-plane" / environment.get("CARGO_TARGET_DIR", "target")).resolve()
        shutil.copytree(target, destination / "target", symlinks=True)
    else:
        shutil.copytree(Path(environment.get("GOCACHE", cache / "go-build")), destination / "go-build")
        modules = Path(environment.get("GOMODCACHE", cache / "go-modules"))
        # VCS transport checkouts may retain authentication settings. Compilers
        # reuse the extracted modules and normal download cache instead.
        shutil.copytree(
            modules, destination / "go-modules",
            ignore=lambda directory, names: {"vcs"} if Path(directory) == modules / "cache" else set(),
        )
    (destination / "source.json").write_text(json.dumps(inputs) + "\n")


def restore_cache(
    seed: Path | None, workspace: Path, cache: Path, environment: dict[str, str], component: str,
) -> None:
    """Seed missing native state before prepare_workspace reapplies the captured source inputs."""
    receipt = workspace.with_suffix(".json")
    target = (
        (workspace / "data-plane" / environment.get("CARGO_TARGET_DIR", "target")).resolve()
        if component != "control-plane" else None
    )
    # The component workspace is serialized; remove a previous writer's interrupted restore.
    staging = workspace.with_name(".compiler-cache")
    if staging.exists():
        shutil.rmtree(staging)
    native_state = target if target is not None else receipt
    if seed is None or native_state.exists():
        return
    staging.mkdir(parents=True)
    try:
        source = staging / "source"
        shutil.copyfile(seed / "source.json", staging / "source.json")
        shutil.copytree(seed / "source", source, symlinks=True)
        if target is not None:
            staged_target = source / target.relative_to(workspace) if target.is_relative_to(workspace) else staging / "target"
            shutil.copytree(seed / "target", staged_target, symlinks=True)
            if not target.is_relative_to(workspace):
                target.parent.mkdir(parents=True, exist_ok=True)
                staged_target.rename(target)
        else:
            for name, variable in (("go-build", "GOCACHE"), ("go-modules", "GOMODCACHE")):
                restore_shared_cache(seed / name, Path(environment.get(variable, cache / name)))
        # Captured inputs own user edits. Invalidate the receipt before replacing
        # a Python-only workspace that has not initialized its Rust target yet.
        receipt.unlink(missing_ok=True)
        if workspace.exists():
            shutil.rmtree(workspace)
        source.rename(workspace)
        (staging / "source.json").replace(receipt)
    finally:
        shutil.rmtree(staging)


def restore_shared_cache(source: Path, destination: Path) -> None:
    """Atomically add missing Go cache entries without replacing another compiler's files."""
    destination.mkdir(parents=True, exist_ok=True)
    for original in source.iterdir():
        target = destination / original.name
        if original.is_dir():
            restore_shared_cache(original, target)
        elif not target.exists():
            # A temporary file on the destination filesystem allows an atomic
            # create-if-absent even when another compiler populates the same entry.
            with tempfile.NamedTemporaryFile(prefix=".compiler-cache-", dir=destination) as temporary:
                with original.open("rb") as contents:
                    shutil.copyfileobj(contents, temporary)
                temporary.flush()
                os.chmod(temporary.name, stat.S_IMODE(original.stat().st_mode))
                try:
                    os.link(temporary.name, target)
                except FileExistsError:
                    pass


def compile_controller(root: Path, output: Path, cache: Path, environment: dict[str, str]) -> None:
    """Build the controller executables and API definitions with persistent Go caches."""
    environment.update(CGO_ENABLED="0", GOOS="linux")
    environment.setdefault("GOFLAGS", "-modcacherw")
    environment.setdefault("GOMODCACHE", str(cache / "go-modules"))
    environment.setdefault("GOCACHE", str(cache / "go-build"))
    jobs = ["-p", environment["BUILD_JOBS"]] if environment.get("BUILD_JOBS") else []
    binaries = output / "bin"
    binaries.mkdir(exist_ok=True)
    for executable, package in (("manager", "./cmd"), ("crd-apply", "./cmd/crd-apply"), ("video-worker", "./cmd/video-worker")):
        subprocess.run(
            ["go", "build", *jobs, "-trimpath", "-ldflags=-s -w", "-o", str(binaries / executable), package],
            cwd=root / "control-plane", env=environment, check=True,
        )
    definitions = output / "crds"
    if definitions.exists():
        shutil.rmtree(definitions)
    shutil.copytree(root / "control-plane/config/crd/bases", definitions)


def compile_rust(root: Path, component: str, output: Path, cache: Path, environment: dict[str, str]) -> None:
    """Prepare declared Rust inputs and compile against the workspace's persistent target directory."""
    environment.setdefault("CARGO_HOME", str(cache / "cargo-home"))
    environment.setdefault("CARGO_TARGET_DIR", str(root / "data-plane/target"))
    if environment.get("BUILD_JOBS"):
        environment["CARGO_BUILD_JOBS"] = environment["BUILD_JOBS"]
    if mirror := environment.get("FORETOKEN_GITHUB_MIRROR"):
        index = int(environment.get("GIT_CONFIG_COUNT", "0"))
        environment[f"GIT_CONFIG_KEY_{index}"] = f"url.{mirror.rstrip('/')}/.insteadOf"
        environment[f"GIT_CONFIG_VALUE_{index}"] = "https://github.com/"
        environment["GIT_CONFIG_COUNT"] = str(index + 1)
    cargo = ["cargo"]
    if (registry := environment.get("FORETOKEN_CARGO_REGISTRY")) and registry != "sparse+https://index.crates.io/":
        cargo += [
            "--config", 'source.crates-io.replace-with="foretoken-mirror"',
            "--config", "source.foretoken-mirror.registry=" + json.dumps(registry),
        ]
    subprocess.run(
        [sys.executable, "-I", str(root / "data-plane/prepare-vllm"), "--cache", str(cache / "vllm")],
        cwd=root, env=environment, check=True,
    )
    subprocess.run(
        [*cargo, "run", "--locked", "--manifest-path", "xtask/Cargo.toml", "--", "prepare-vllm"],
        cwd=root / "data-plane", env=environment, check=True,
    )

    # Image layers restore source mtimes on each solve. Keep the prepared tree beside
    # Cargo's artifacts so unchanged dependencies remain incremental in both callers.
    target = (root / "data-plane" / environment["CARGO_TARGET_DIR"]).resolve()
    metadata = tomllib.loads((root / "data-plane/Cargo.toml").read_text())["workspace"]["metadata"]["foretoken"]
    upstream = root / "data-plane" / metadata["vllm_source"] / "rust"
    prepared = target / "vllm-rust"
    if not same_tree(prepared, upstream):
        with tempfile.TemporaryDirectory(prefix=".vllm-rust-", dir=target) as temporary:
            staged = Path(temporary) / "rust"
            shutil.copytree(upstream, staged)
            for source in staged.rglob("*"):
                if source.is_file():
                    source.touch()
            if prepared.exists():
                shutil.rmtree(prepared)
            staged.rename(prepared)
    for source in prepared.rglob("*"):
        if source.is_file():
            shutil.copystat(source, upstream / source.relative_to(prepared))

    binary = "foretoken-frontend" if component == "frontend" else environment.get("FORETOKEN_MODEL_SERVER_BINARY", "foretoken-model-server")
    package = "foretoken-frontend" if component == "frontend" else "foretoken-model-server"
    subprocess.run(
        [*cargo, "run", "--locked", "--manifest-path", "xtask/Cargo.toml", "--", "build", "--",
         *cargo[1:], "--release", "--package", package, "--bin", binary],
        cwd=root / "data-plane", env=environment, check=True,
    )
    binaries = output / "bin"
    binaries.mkdir(exist_ok=True)
    destination = binaries / ("foretoken-frontend" if component == "frontend" else "foretoken-model-server")
    shutil.copyfile(target / "release" / binary, destination)
    destination.chmod(0o755)


def same_tree(left: Path, right: Path) -> bool:
    """Compare prepared source bytes and file modes without relying on Git or mtimes."""
    if not left.is_dir():
        return False
    before = {path.relative_to(left): path for path in left.rglob("*") if path.is_file()}
    after = {path.relative_to(right): path for path in right.rglob("*") if path.is_file()}
    if before.keys() != after.keys():
        return False
    filecmp.clear_cache()
    return all(
        stat.S_IMODE(path.stat().st_mode) == stat.S_IMODE(after[name].stat().st_mode)
        and filecmp.cmp(path, after[name], shallow=False)
        for name, path in before.items()
    )


if __name__ == "__main__":
    main()
