+def configure_mccl_visible_hcas() -> None:
+    """Exclude RoCE ports without a usable GID in the worker's network namespace.
+
+    Called by platform configuration before Torch or PyNccl creates communicators.
+    Explicit HCA selection and ordinary InfiniBand selection remain unchanged.
+    """
+    if "MCCL_IB_HCA" in os.environ:
+        return
+    excluded = []
+    for device in sorted(Path("/sys/class/infiniband").glob("*")):
+        for port in sorted((device / "ports").glob("*")):
+            if (port / "link_layer").read_text().strip() != "Ethernet":
+                continue
+            for gid in (port / "gids").iterdir():
+                try:
+                    address = gid.read_text().strip()
+                    kind = (port / "gid_attrs/types" / gid.name).read_text().strip()
+                except OSError as error:
+                    if error.errno in (errno.EINVAL, errno.ENOENT):
+                        continue
+                    raise
+                if int(address.replace(":", ""), 16) and kind in (
+                    "IB/RoCE v1",
+                    "RoCE v1",
+                    "RoCE v2",
+                ):
+                    break
+            else:
+                excluded.append(f"{device.name}:{port.name}")
+    if excluded:
+        os.environ["MCCL_IB_HCA"] = "^=" + ",".join(excluded)
+        logger.info("Excluding RoCE ports without namespace-visible GIDs: %s", excluded)
