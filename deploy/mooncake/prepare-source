"""Prepare Mooncake source and declared dependencies without requiring a Git checkout."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import shutil
import subprocess
import tarfile
import tempfile
import urllib.request
from pathlib import Path
from typing import Any
from urllib.parse import quote


class MooncakeSource:
    """Own source materialization and patch updates, preserving supplied local files."""

    def __init__(self, root: Path, *, destination: Path | None = None, cache: Path | None = None) -> None:
        self.root = root
        self.directory = destination if destination is not None else root / "third_party/mooncake"
        self.archive_cache = cache
        self.git_executable = shutil.which("git")
        self.record_path = self.directory / ".foretoken-source.json"
        self.record = json.loads(self.record_path.read_text()) if self.record_path.is_file() else {}
        configuration = json.loads((root / "deploy/mooncake/source-environment.json").read_text())
        requested = os.environ.get("MOONCAKE_VERSION") or configuration["defaultVersion"]
        releases = configuration["releases"]
        selected = next((version for version, release in releases.items() if requested in {version, release["revision"]}), None)
        if selected is None:
            raise ValueError(f"Unsupported MOONCAKE_VERSION={requested}; expected one of {', '.join(releases)}")
        self.source = dict(self.record.get("source", {"kind": "local", "revision": None}))
        self.recipe = releases[selected]
        self.repository = configuration["repository"]
        self.patches = [{"path": name, "contents": (root / name).read_text()} for name in self.recipe["patches"]]
        self.dependencies = {name: dict(dependency) for name, dependency in self.recipe["dependencies"].items()}

    def describe(self) -> dict[str, Any]:
        """Describe declared build inputs without preparing files or querying version-control metadata."""
        return {
            "revision": self.recipe["revision"],
            "patches": self.recipe["patches"],
            "dependencies": {"third_party/mooncake/" + name: dependency for name, dependency in self.dependencies.items()},
        }

    def prepared(self) -> bool:
        """Check actual files, dependency licenses and applied patches rather than Git cleanliness."""
        if not self._complete_source():
            return False
        if self.source["kind"] == "managed" and self.source["revision"] != self.recipe["revision"]:
            return False
        if any(not self._complete_dependency(self.directory / name) for name in self.dependencies):
            return False
        previous = self.record.get("patches", [])
        if previous and previous != self.patches:
            return False
        if self.git_executable is None:
            return False
        return all(self._patch(self.directory, patch["contents"], reverse=True, check=True).returncode == 0 for patch in self.patches)

    def prepare(self) -> None:
        """Materialize declared dependencies and apply patches without resetting supplied source files."""
        if self.source["kind"] == "local" and self.git_executable is not None and (self.directory / ".git").exists():
            result = subprocess.run(
                [self.git_executable, "-C", str(self.directory), "rev-parse", "HEAD"], text=True, capture_output=True, check=False,
                env={**os.environ, "GIT_NO_LAZY_FETCH": "1", "GIT_OPTIONAL_LOCKS": "0"},
            )
            if result.returncode == 0:
                self.source["revision"] = result.stdout.strip()
        if not self.directory.exists() or not any(self.directory.iterdir()):
            self._download(self.directory, self.repository, self.recipe["revision"])
            self.source = {"kind": "managed", "repository": self.repository, "revision": self.recipe["revision"]}
            self._save([])
        if not self._complete_source():
            raise ValueError(f"Mooncake source at {self.directory} is incomplete; existing files were preserved")
        if self.source["kind"] == "managed" and self.source["revision"] != self.recipe["revision"]:
            raise ValueError(
                f"Managed Mooncake source is at {self.source['revision']}, not {self.recipe['revision']}; "
                "preserve that source directory before preparing another version"
            )
        for name, dependency in self.dependencies.items():
            destination = self.directory / name
            if self._complete_dependency(destination):
                continue
            if destination.exists() and any(destination.iterdir()):
                raise ValueError(f"Mooncake dependency {name} is incomplete; existing local files were preserved")
            self._download(destination, dependency["repository"], dependency["revision"])
        self._prepare_patches()
        self._save(self.patches)
        print(f"Prepared Mooncake source at {self.directory} ({self.source['kind']}).")

    def _complete_source(self) -> bool:
        return (
            (self.directory / "CMakeLists.txt").is_file()
            and (self.directory / "LICENSE-APACHE").is_file()
            and (self.directory / "mooncake-store").is_dir()
            and (self.directory / "mooncake-transfer-engine").is_dir()
        )

    @staticmethod
    def _complete_dependency(directory: Path) -> bool:
        return (directory / "CMakeLists.txt").is_file() and (directory / "LICENSE").is_file()

    def _download(self, destination: Path, repository: str, revision: str) -> None:
        """Materialize a licensed upstream tree without holding the shared download lock during extraction."""
        destination.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix=".mooncake-source-", dir=destination.parent) as temporary:
            staging = Path(temporary)
            cache = self.archive_cache if self.archive_cache is not None else staging / "archives"
            archive = self._cached_archive(repository, revision, cache)
            unpacked = staging / "unpacked"
            unpacked.mkdir()
            with tarfile.open(archive, "r:gz") as package:
                package.extractall(unpacked, filter="data")
            (source,) = unpacked.iterdir()
            if destination.exists():
                destination.rmdir()
            source.rename(destination)

    def _cached_archive(self, repository: str, revision: str, cache: Path) -> Path:
        """Publish one complete upstream archive under its repository/revision download lock."""
        archive = cache / quote(repository.removesuffix(".git"), safe="") / (revision + ".tar.gz")
        archive.parent.mkdir(parents=True, exist_ok=True)
        # Workspace extraction and patch preparation happen after this lock is released.
        with archive.with_name(archive.name + ".lock").open("a+") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if not archive.is_file():
                with tempfile.TemporaryDirectory(prefix=".mooncake-download-", dir=archive.parent) as temporary:
                    received = Path(temporary) / "source.tar.gz"
                    url = repository.removesuffix(".git") + f"/archive/{revision}.tar.gz"
                    mirror = os.environ.get("FORETOKEN_GITHUB_MIRROR")
                    if mirror and url.startswith("https://github.com/"):
                        url = mirror.rstrip("/") + url.removeprefix("https://github.com")
                    with urllib.request.urlopen(url) as response, received.open("wb") as output:
                        shutil.copyfileobj(response, output)
                    with tarfile.open(received, "r:gz") as package:
                        members = package.getmembers()
                    roots = {Path(member.name).parts[0] for member in members if Path(member.name).parts}
                    if len(roots) != 1:
                        raise ValueError(f"Source archive from {repository} must contain one project directory")
                    project = roots.pop()
                    files = {member.name for member in members if member.isfile()}
                    if f"{project}/CMakeLists.txt" not in files or not any(f"{project}/{name}" in files for name in ("LICENSE", "LICENSE-APACHE")):
                        raise ValueError(f"Downloaded source from {repository} is missing CMakeLists.txt or its license")
                    received.replace(archive)
        return archive

    def _patch(self, source: Path, contents: str, *, reverse: bool = False, check: bool = False) -> subprocess.CompletedProcess[str]:
        """Use Git's filesystem patch engine without requiring or updating a repository index."""
        command = ["git", "apply", "--directory=" + source.name]
        if reverse:
            command.append("--reverse")
        if check:
            command.append("--check")
        environment = {name: value for name, value in os.environ.items() if name not in {"GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE"}}
        environment.update(GIT_CEILING_DIRECTORIES=str(source.parent), GIT_OPTIONAL_LOCKS="0", GIT_NO_LAZY_FETCH="1")
        return subprocess.run(command, cwd=source.parent, env=environment, input=contents, text=True, capture_output=True, check=False)

    def _prepare_patches(self) -> None:
        """Stage only patch-owned files so a conflicting update cannot alter supplied source."""
        if self.git_executable is None:
            raise ValueError("Git is required to check and apply Mooncake patches")
        if self.prepared():
            return
        previous = self.record.get("patches", [])
        if not previous and self.recipe.get("legacyPatches"):
            legacy = [{"path": name, "contents": (self.root / name).read_text()} for name in self.recipe["legacyPatches"]]
            if all(self._patch(self.directory, patch["contents"], reverse=True, check=True).returncode == 0 for patch in legacy):
                previous = legacy
        patches = previous + self.patches
        names = set()
        for patch in patches:
            result = subprocess.run(["git", "apply", "--numstat", "-z"], input=patch["contents"], text=True, capture_output=True, check=True)
            names.update(entry.split("\t", 2)[2] for entry in result.stdout.split("\0") if entry)
        for name in names:
            path = Path(name)
            if not path.parts or path.is_absolute() or ".." in path.parts:
                raise ValueError(f"Mooncake patch path must stay within its source tree: {name}")
        with tempfile.TemporaryDirectory(prefix=".mooncake-patches-", dir=self.directory.parent) as temporary:
            staged = Path(temporary) / "source"
            staged.mkdir()
            for name in names:
                source = self.directory / name
                if source.is_file():
                    target = staged / name
                    target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(source, target)
            if previous and previous != self.patches:
                for patch in reversed(previous):
                    result = self._patch(staged, patch["contents"], reverse=True)
                    if result.returncode:
                        raise ValueError(f"Cannot update {patch['path']} with local changes: {result.stderr.strip()}")
            for patch in self.patches:
                if self._patch(staged, patch["contents"], reverse=True, check=True).returncode == 0:
                    continue
                result = self._patch(staged, patch["contents"])
                if result.returncode:
                    raise ValueError(f"Cannot apply {patch['path']} to local Mooncake source: {result.stderr.strip()}")
            for name in names:
                source, destination = staged / name, self.directory / name
                if source.is_file():
                    if destination.is_file() and source.read_bytes() == destination.read_bytes() and source.stat().st_mode == destination.stat().st_mode:
                        continue
                    destination.parent.mkdir(parents=True, exist_ok=True)
                    source.replace(destination)
                else:
                    destination.unlink(missing_ok=True)

    def _save(self, patches: list[dict[str, str]]) -> None:
        """Record upstream provenance and actual patch text independently of repository metadata."""
        value = {"source": self.source, "patches": patches}
        if self.record_path.is_file() and json.loads(self.record_path.read_text()) == value:
            return
        with tempfile.NamedTemporaryFile(mode="w", dir=self.directory, delete=False) as output:
            temporary = Path(output.name)
            try:
                json.dump(value, output, indent=2)
                output.write("\n")
                output.close()
                temporary.replace(self.record_path)
            finally:
                temporary.unlink(missing_ok=True)
        self.record = value


def main() -> None:
    """Describe source recipes or prepare their files for repository build callers."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", nargs="?", choices=("prepare",), default="prepare")
    parser.add_argument("--destination", type=Path, help="Source directory selected by the build executor")
    parser.add_argument("--cache", type=Path, help="Caller-owned cache directory for upstream source archives")
    parser.add_argument("--describe", action="store_true")
    arguments = parser.parse_args()
    try:
        source = MooncakeSource(
            Path(__file__).resolve().parents[2],
            destination=arguments.destination.expanduser().resolve() if arguments.destination is not None else None,
            cache=arguments.cache.expanduser().resolve() if arguments.cache is not None else None,
        )
        if arguments.describe:
            print(json.dumps(source.describe()))
        else:
            source.prepare()
    except (OSError, ValueError, tarfile.TarError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"Mooncake source preparation failed: {error}\n")


if __name__ == "__main__":
    main()
