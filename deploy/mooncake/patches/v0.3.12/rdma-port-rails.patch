+void Topology::expandDevicePorts(
+    const std::unordered_map<std::string, std::vector<std::string>> &rails) {
+    auto expand = [&rails](std::vector<std::string> &devices) {
+        std::vector<std::string> expanded;
+        for (const auto &device : devices) {
+            const auto &ports = rails.at(device);
+            expanded.insert(expanded.end(), ports.begin(), ports.end());
+        }
+        devices = std::move(expanded);
+    };
+    for (auto &[location, entry] : matrix_) {
+        expand(entry.preferred_hca);
+        expand(entry.avail_hca);
+    }
+    resolve();
+}
