+std::vector<uint8_t> discoverActiveRdmaPorts(const std::string &device_name,
+                                          uint8_t port) {
+    int count = 0;
+    auto **devices = ibv_get_device_list(&count);
+    if (!devices) {
+        PLOG(WARNING) << "Failed to enumerate RDMA devices";
+        return {};
+    }
+    std::vector<uint8_t> ports;
+    for (int i = 0; i < count; ++i) {
+        if (device_name == ibv_get_device_name(devices[i])) {
+            ports = activeIbDevicePorts(devices[i], port);
+            break;
+        }
+    }
+    ibv_free_device_list(devices);
+    return ports;
