+// Keep initial preference and retry ordering identical for physical and port hints.
+static int selectHca(const std::vector<int> &preferred,
+                     const std::vector<int> &available, int retry_count,
+                     bool round_robin) {
+    if (preferred.empty() && available.empty()) return ERR_DEVICE_NOT_FOUND;
+    if (retry_count == 0) {
+        int choice;
+        if (round_robin) {
+            thread_local int counter = 0;
+            choice = counter;
+            counter = (counter + 1) % 10000;
+        } else {
+            choice = SimpleRandom::Get().next();
+        }
+        const auto &candidates = preferred.empty() ? available : preferred;
+        return candidates[choice % candidates.size()];
+    }
+    size_t index = (retry_count - 1) % (preferred.size() + available.size());
+    return index < preferred.size() ? preferred[index]
+                                    : available[index - preferred.size()];
+}
