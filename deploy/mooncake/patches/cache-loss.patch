+// Cache-loss quiescence must not revoke a returned SSD buffer; only the
+// reader's explicit release ends its lifetime after the provider is fenced.
+TEST_F(FileStorageTest, CacheLossRetainsReturnedBufferUntilRelease) {
+    std::filesystem::path master_root =
+        std::filesystem::path(data_path) / "cache_loss_master";
+    std::filesystem::create_directories(master_root);
+
+    testing::InProcMaster master;
+    auto master_config = InProcMasterConfigBuilder()
+                             .set_enable_offload(true)
+                             .set_root_fs_dir(master_root.string())
+                             .build();
+    ASSERT_TRUE(master.Start(master_config));
+
+    std::string local_rpc_addr =
+        "127.0.0.1:" + std::to_string(getFreeTcpPort());
+    auto client = Client::Create(local_rpc_addr, master.metadata_url(), "tcp",
+                                 std::nullopt, master.master_address());
+    ASSERT_TRUE(client.has_value());
+
+    FileStorageConfig config = FileStorageConfig::FromEnvironment();
+    config.storage_backend_type = StorageBackendType::kFilePerKey;
+    config.storage_filepath = data_path + "/cache_loss";
+    config.local_buffer_size = 4 * 1024 * 1024;
+    config.client_buffer_gc_interval_seconds = 1;
+    config.client_buffer_gc_ttl_ms = 10;
+    fs::create_directories(config.storage_filepath);
+
+    FileStorage file_storage(config, client.value(), local_rpc_addr);
+    ASSERT_TRUE(file_storage.Init());
+
+    std::vector<std::string> keys;
+    std::vector<int64_t> sizes;
+    std::unordered_map<std::string, std::string> data;
+    ASSERT_TRUE(FileStorageBatchOffload(file_storage, keys, sizes, data));
+    ASSERT_FALSE(keys.empty());
+    std::vector<std::string> read_keys{keys.front()};
+    std::vector<int64_t> read_sizes{sizes.front()};
+
+    auto batch = file_storage.BatchGet(read_keys, read_sizes);
+    ASSERT_TRUE(batch.has_value());
+    ASSERT_EQ(batch->pointers.size(), 1);
+    auto* returned = reinterpret_cast<const char*>(batch->pointers[0]);
+    ASSERT_EQ(std::string(returned, static_cast<size_t>(sizes[0])), data[keys[0]]);
+
+    auto start = std::chrono::steady_clock::now();
+    auto fence = file_storage.BeginCacheLossQuiesce();
+    ASSERT_TRUE(fence.has_value());
+    EXPECT_LT(std::chrono::steady_clock::now() - start, std::chrono::seconds(1));
+    auto rejected = file_storage.BatchGet(keys, sizes);
+    ASSERT_FALSE(rejected.has_value());
+    EXPECT_EQ(rejected.error(), ErrorCode::UNAVAILABLE_IN_CURRENT_STATUS);
+
+    std::this_thread::sleep_for(std::chrono::seconds(2));
+    auto status = file_storage.GetCacheLossStatus();
+    EXPECT_TRUE(status.quiesced);
+    EXPECT_EQ(status.allocated_batches, 1);
+    EXPECT_EQ(std::string(returned, static_cast<size_t>(sizes[0])), data[keys[0]]);
+
+    EXPECT_TRUE(file_storage.ReleaseBuffer(batch->batch_id));
+    EXPECT_EQ(file_storage.GetCacheLossStatus().allocated_batches, 0);
+}
