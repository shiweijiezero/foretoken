+    std::lock_guard<std::mutex> cache_loss_lock(cache_loss_mutex_);
+    std::shared_lock<std::shared_mutex> snapshot_lock(snapshot_mutex_);
+    {
+        auto segment_access = segment_manager_.getLocalDiskSegmentAccess();
+        const auto& segments = segment_access.getClientLocalDiskSegment();
+        auto segment_it = segments.find(client_id);
+        if (segment_it == segments.end()) {
