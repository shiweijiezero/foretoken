+// The owner fence linearizes with offload completion so a late ScanMeta-style
+// notification cannot recreate LOCAL_DISK metadata after cache loss begins.
+TEST_F(MasterServiceTest, CacheLossFenceRejectsLateOwnerMetadata) {
+    MasterServiceConfig config;
+    config.enable_offload = true;
+    std::unique_ptr<MasterService> service(new MasterService(config));
+    const UUID client_id = generate_uuid();
+    const UUID other_client_id = generate_uuid();
+    constexpr size_t buffer = 0x300000000;
+    constexpr size_t size = 1024 * 1024 * 16;
+    auto segment = MakeSegment("cache_loss_segment", buffer, size);
+    ASSERT_TRUE(service->MountSegment(segment, client_id));
+    ASSERT_TRUE(service->MountLocalDiskSegment(client_id, true));
+
+    auto notify_one = [&](const OffloadTaskItem& task) {
+        std::vector<StorageObjectMetadata> metadatas{
+            StorageObjectMetadata{.bucket_id = 0,
+                                  .offset = 0,
+                                  .key_size =
+                                      static_cast<int64_t>(task.key.size()),
+                                  .data_size = task.size,
+                                  .transport_endpoint = "127.0.0.1:9003"}};
+        return service->NotifyOffloadSuccess(client_id, {task}, metadatas);
+    };
+    auto has_owned_disk = [&](const std::string& key) {
+        auto query = service->GetReplicaListForAdmin(key, "default");
+        EXPECT_TRUE(query.has_value());
+        if (!query) return false;
+        return std::any_of(
+            query->replicas.begin(), query->replicas.end(),
+            [&](const Replica::Descriptor& replica) {
+                return replica.is_local_disk_replica() &&
+                       replica.get_local_disk_descriptor().client_id == client_id;
+            });
+    };
+
+    const std::string existing_key =
+        GenerateKeyForSegment(client_id, service, segment.name);
+    auto existing_tasks = service->OffloadObjectHeartbeat(client_id, true);
+    ASSERT_TRUE(existing_tasks.has_value());
+    ASSERT_EQ(existing_tasks->size(), 1);
+    ASSERT_TRUE(notify_one(existing_tasks->front()));
+    auto clear_memory =
+        service->BatchReplicaClear({existing_key}, client_id, segment.name);
+    ASSERT_TRUE(clear_memory.has_value());
+    ASSERT_EQ(clear_memory->size(), 1);
+    ASSERT_TRUE(has_owned_disk(existing_key));
+
+    const std::string late_key =
+        GenerateKeyForSegment(client_id, service, segment.name);
+    auto late_tasks = service->OffloadObjectHeartbeat(client_id, true);
+    ASSERT_TRUE(late_tasks.has_value());
+    ASSERT_EQ(late_tasks->size(), 1);
+    const std::string queued_key =
+        GenerateKeyForSegment(client_id, service, segment.name);
+    const std::string racing_key = "cache_loss_racing_put";
+    auto racing_put = service->PutStart(client_id, racing_key, "default", {1024},
+                                        {.replica_num = 1});
+    ASSERT_TRUE(racing_put.has_value());
+
+    auto fence = service->BeginCacheLossQuiesce(client_id);
+    ASSERT_TRUE(fence.has_value());
+    auto repeated_fence = service->BeginCacheLossQuiesce(client_id);
+    ASSERT_TRUE(repeated_fence.has_value());
+    EXPECT_EQ(repeated_fence.value(), fence.value());
+    auto disabled_heartbeat = service->OffloadObjectHeartbeat(client_id, false);
+    ASSERT_TRUE(disabled_heartbeat.has_value());
+    EXPECT_TRUE(disabled_heartbeat->empty());
+    EXPECT_TRUE(service->Remove(queued_key, "default", true).has_value());
+
+    auto remount = service->MountLocalDiskSegment(client_id, true);
+    ASSERT_FALSE(remount.has_value());
+    EXPECT_EQ(remount.error(), ErrorCode::UNAVAILABLE_IN_CURRENT_STATUS);
+    auto heartbeat = service->OffloadObjectHeartbeat(client_id, true);
+    ASSERT_FALSE(heartbeat.has_value());
+    EXPECT_EQ(heartbeat.error(), ErrorCode::UNAVAILABLE_IN_CURRENT_STATUS);
+
+    auto late_notify = notify_one(late_tasks->front());
+    ASSERT_FALSE(late_notify.has_value());
+    EXPECT_EQ(late_notify.error(), ErrorCode::UNAVAILABLE_IN_CURRENT_STATUS);
+    EXPECT_FALSE(has_owned_disk(late_key));
+
+    std::barrier start(3);
+    std::optional<tl::expected<void, ErrorCode>> racing_put_end;
+    std::optional<
+        tl::expected<MasterService::CacheLossResult, ErrorCode>> concurrent_drop;
+    std::thread writer([&]() {
+        start.arrive_and_wait();
+        racing_put_end =
+            service->PutEnd(client_id, racing_key, "default", ReplicaType::MEMORY);
+    });
+    std::thread dropper([&]() {
+        start.arrive_and_wait();
+        concurrent_drop =
+            service->DropLocalDiskReplicas(client_id, fence.value());
+    });
+    start.arrive_and_wait();
+    writer.join();
+    dropper.join();
+
+    ASSERT_TRUE(racing_put_end.has_value());
+    ASSERT_TRUE(racing_put_end->has_value());
+    ASSERT_TRUE(concurrent_drop.has_value());
+    ASSERT_TRUE(concurrent_drop->has_value());
+    EXPECT_EQ(concurrent_drop->value().removed_replicas, 1);
+    EXPECT_EQ(concurrent_drop->value().removed_objects, 1);
+    auto removed = service->GetReplicaListForAdmin(existing_key, "default");
+    ASSERT_FALSE(removed.has_value());
+    EXPECT_EQ(removed.error(), ErrorCode::OBJECT_NOT_FOUND);
+    auto repeated_drop =
+        service->DropLocalDiskReplicas(client_id, fence.value());
+    ASSERT_TRUE(repeated_drop.has_value());
+    EXPECT_EQ(repeated_drop->removed_replicas, 0);
+
+    ASSERT_TRUE(service->MountLocalDiskSegment(other_client_id, true));
+    auto other_fence = service->BeginCacheLossQuiesce(other_client_id);
+    ASSERT_TRUE(other_fence.has_value());
+    EXPECT_FALSE(
+        service->DropLocalDiskReplicas(client_id, other_fence.value()).has_value());
+    EXPECT_FALSE(
+        service->DropLocalDiskReplicas(other_client_id, fence.value()).has_value());
+}
