+    for (size_t shard_index = 0; shard_index < kNumShards; ++shard_index) {
+        MetadataShardAccessorRW shard(this, shard_index);
+        for (auto tenant_it = shard->tenants.begin();
+             tenant_it != shard->tenants.end();) {
+            auto& tenant_state = tenant_it->second;
+            for (auto metadata_it = tenant_state.metadata.begin();
+                 metadata_it != tenant_state.metadata.end();) {
+                auto& metadata = metadata_it->second;
+                const std::function<bool(const Replica&)> owner =
+                    [&client_id](const Replica& replica) {
+                        const auto owner_id = replica.get_local_disk_client_id();
+                        return owner_id.has_value() &&
+                               owner_id.value() == client_id;
+                    };
+                if (!metadata.HasReplica(owner)) {
+                    ++metadata_it;
+                    continue;
+                }
+
+                const bool had_completed_owned = metadata.HasReplica(
+                    [&owner](const Replica& replica) {
+                        return owner(replica) && replica.is_completed();
+                    });
+                const size_t removed =
+                    EraseReplicasWithCacheTotalAccounting(metadata, owner);
+                result.removed_replicas += removed;
+                const bool has_completed_local_disk = metadata.HasReplica(
+                    [](const Replica& replica) {
+                        return replica.is_local_disk_replica() &&
+                               replica.is_completed();
+                    });
+                if (had_completed_owned && !has_completed_local_disk) {
+                    if (metadata.IsValid()) {
+                        shard.OnDiskReplicaRemoved(true, metadata);
+                    } else {
+                        shard.OnDiskReplicaRemoved(true);
+                    }
+                }
+
+                if (!metadata.IsValid()) {
+                    PublishKvRemoved(metadata_it->first, metadata,
+                                     tenant_it->first);
+                    metadata_it = EraseMetadata(tenant_state, metadata_it,
+                                                tenant_it->first,
+                                                QuotaEraseMode::kFull, &shard);
+                    ++result.removed_objects;
+                } else {
+                    ++metadata_it;
+                }
+            }
+            if (tenant_state.Empty()) {
+                tenant_it = shard->tenants.erase(tenant_it);
+            } else {
+                ++tenant_it;
+            }
+        }
+    }
+
+    LOG(INFO) << "client_id=" << client_id
+              << ", action=drop_local_disk_replicas"
+              << ", removed_replicas=" << result.removed_replicas
+              << ", removed_objects=" << result.removed_objects;
+    return result;
+}
