+void MasterAdminServer::HandleDropLocalDiskReplicas(
+    coro_http::coro_http_request& req, coro_http::coro_http_response& resp) {
+    HttpDropLocalDiskReplicasRequest request;
+    try {
+        struct_json::from_json(request, req.get_body());
+    } catch (const std::exception&) {
+        WriteErrorResponse(resp, coro_http::status_type::bad_request,
+                           ErrorCode::INVALID_PARAMS, "Invalid JSON body");
+        return;
+    }
+
+    UUID client_id;
+    if (!StringToUuid(request.client_id, client_id) ||
+        request.fence_token.empty()) {
+        WriteErrorResponse(resp, coro_http::status_type::bad_request,
+                           ErrorCode::INVALID_PARAMS,
+                           "client_id and fence_token are required");
+        return;
+    }
+
+    WithActiveService(resp, [&](auto service) {
+        auto result = service->DropLocalDiskReplicasForAdmin(
+            client_id, request.fence_token);
+        if (!result) {
+            WriteErrorResponse(resp, ErrorCodeToHttpStatus(result.error()),
+                               result.error());
+            return;
+        }
+        WriteJsonResponse(
+            resp, coro_http::status_type::ok,
+            HttpDropLocalDiskReplicasResponse{
+                .client_id = UuidToString(client_id),
+                .removed_replicas = result->removed_replicas,
+                .removed_objects = result->removed_objects});
+    });
+}
