+tl::expected<std::string, ErrorCode> FileStorage::BeginCacheLossQuiesce() {
+    // This lock is the local linearization point: later reads are rejected and
+    // later GC passes retain every batch until its reader explicitly releases it.
+    {
+        MutexLocker lock(&client_buffer_mutex_);
+        cache_loss_quiescing_ = true;
+    }
+
+    auto fence_result = client_->BeginCacheLossQuiesce();
+    if (!fence_result) {
+        return tl::make_unexpected(fence_result.error());
+    }
+    {
+        MutexLocker lock(&client_buffer_mutex_);
+        cache_loss_fence_token_ = fence_result.value();
+    }
+    return fence_result.value();
+}
