+// Cache-loss fencing is part of SSD membership and must survive the same
+// snapshot round trip that restores LOCAL_DISK registration.
+TEST_F(SegmentTest, CacheLossFenceSurvivesSnapshotRestore) {
+    SegmentManager source(BufferAllocatorType::OFFSET);
+    const UUID client_id = generate_uuid();
+    std::string fence_token;
+    {
+        auto access = source.getSegmentAccess();
+        auto missing_fence = access.BeginCacheLossQuiesce(client_id);
+        ASSERT_FALSE(missing_fence.has_value());
+        EXPECT_EQ(missing_fence.error(), ErrorCode::SEGMENT_NOT_FOUND);
+        ASSERT_EQ(access.MountLocalDiskSegment(client_id, true), ErrorCode::OK);
+        auto fence = access.BeginCacheLossQuiesce(client_id);
+        ASSERT_TRUE(fence.has_value());
+        fence_token = fence.value();
+    }
+
+    SegmentSerializer source_serializer(&source);
+    auto snapshot = source_serializer.Serialize();
+    ASSERT_TRUE(snapshot.has_value());
+
+    SegmentManager restored(BufferAllocatorType::OFFSET);
+    SegmentSerializer restored_serializer(&restored);
+    ASSERT_TRUE(restored_serializer.Deserialize(snapshot.value()));
+    auto access = restored.getSegmentAccess();
+    auto restored_fence = access.BeginCacheLossQuiesce(client_id);
+    ASSERT_TRUE(restored_fence.has_value());
+    EXPECT_EQ(restored_fence.value(), fence_token);
+    EXPECT_EQ(access.MountLocalDiskSegment(client_id, true),
+              ErrorCode::UNAVAILABLE_IN_CURRENT_STATUS);
+}
