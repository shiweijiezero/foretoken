+
+void MasterAdminServer::HandleClientRegistration(
+    coro_http::coro_http_request& req, coro_http::coro_http_response& resp) {
+    UUID client_id;
+    if (!StringToUuid(std::string(req.get_query_value("client_id")), client_id)) {
+        resp.set_status_and_content(coro_http::status_type::bad_request,
+                                    "client_id must be a UUID");
+        return;
+    }
+    WithActiveService(resp, [&](auto service) {
+        auto registration = service->GetClientSsdRegistrationForAdmin(client_id);
+        HttpClientRegistrationResponse payload{
+            UuidToString(client_id), registration.registered,
+            registration.capacity_bytes};
+        WriteJsonResponse(resp, coro_http::status_type::ok, payload);
+    });
+}
