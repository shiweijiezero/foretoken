+MasterService::ClientSsdRegistration MasterService::GetClientSsdRegistration(
+    const UUID& client_id) {
+    std::shared_lock<std::shared_mutex> snapshot_lock(snapshot_mutex_);
+    auto access = segment_manager_.getLocalDiskSegmentAccess();
+    auto& segments = access.getClientLocalDiskSegment();
+    auto it = segments.find(client_id);
+    if (it == segments.end()) {
+        return {};
+    }
+    MutexLocker locker(&it->second->offloading_mutex_);
+    return {true, it->second->ssd_total_capacity_bytes};
+}
