        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(DCGM_FI_DEV_GPU_TEMP{foretoken_observability_source=\"accelerator\",foretoken_accelerator_vendor=\"nvidia\",foretoken_accelerator_exporter=\"dcgm\",instance=~\"${instance:regex}\",gpu=~\"${gpu:regex}\"})",
          "instant": true,
          "legendFormat": "最高温度",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "当前最高 GPU 核心温度",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
