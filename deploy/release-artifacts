# Build, export, or publish one version of runtime environments, applications, and the Helm chart.
set -euo pipefail

# Parse release options, resolve the immutable version, and dispatch one release mode.
main() {
  ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
  SOURCE_URL=${FORETOKEN_SOURCE_URL:-https://github.com/shiweijiezero/foretoken}
  OUTPUT_DIR=${FORETOKEN_RELEASE_OUTPUT:-/tmp/foretoken-release}
  COMPONENTS=control-plane,frontend,model-server,model-server-metax,chart
  REGISTRY=
  DRY_RUN=false
  PLAIN_HTTP=false
  PYTHON=${FORETOKEN_PYTHON:-python}
  BUILD_DRIVER=
  PAYLOAD_DIR=
  CACHE_EXPORT=
  export FORETOKEN_PYTHON="$PYTHON"
  trap cleanup EXIT

  [[ $# -gt 0 ]] || {
    usage >&2
    exit 2
  }
  MODE=$1
  shift
  case "$MODE" in
    build | export | push) ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown mode: %s\n' "$MODE" >&2
      usage >&2
      exit 2
      ;;
  esac

  while (($# > 0)); do
    case "$1" in
      --registry)
        [[ $# -ge 2 ]] || {
          printf '%s\n' '--registry requires a value' >&2
          exit 2
        }
        REGISTRY=$2
        shift 2
        ;;
      --components)
        [[ "$MODE" != export ]] || {
          printf '%s\n' 'export produces one complete application archive; --components applies to build and push' >&2
          exit 2
        }
        [[ $# -ge 2 ]] || {
          printf '%s\n' '--components requires a value' >&2
          exit 2
        }
        COMPONENTS=$2
        shift 2
        ;;
      --output-dir)
        [[ $# -ge 2 ]] || {
          printf '%s\n' '--output-dir requires a value' >&2
          exit 2
        }
        OUTPUT_DIR=$2
        shift 2
        ;;
      --dry-run)
        DRY_RUN=true
        shift
        ;;
      --plain-http)
        PLAIN_HTTP=true
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        printf 'unknown option: %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
    esac
  done

  [[ "$MODE" == export || -n "$REGISTRY" ]] || {
    printf '%s\n' '--registry is required' >&2
    exit 2
  }
  REGISTRY=${REGISTRY%/}
  [[ "$MODE" == export || -n "$REGISTRY" ]] || {
    printf '%s\n' '--registry must not contain only slashes' >&2
    exit 2
  }
  [[ -n "$COMPONENTS" ]] || {
    printf '%s\n' '--components must not be empty' >&2
    exit 2
  }

  command -v "$PYTHON" >/dev/null || {
    printf 'missing required command: %s\n' "$PYTHON" >&2
    exit 1
  }

  # Translate the package's PEP 440 release spelling to the OCI/Chart SemVer spelling.
  read -r PYTHON_VERSION OCI_VERSION CONTROL_PLANE_IMAGE FRONTEND_IMAGE MODEL_SERVER_IMAGE MODEL_SERVER_METAX_IMAGE < <(
    "$PYTHON" - "$ROOT" "$REGISTRY" <<'PY'
from pathlib import Path
import sys
import tomllib

import yaml

root = Path(sys.argv[1])
sys.path.insert(0, str(root / "cli"))
from foretoken import environment_image_reference, platform_version_for

with (root / "pyproject.toml").open("rb") as source:
    python_version = tomllib.load(source)["project"]["version"]
with (root / "deploy/charts/foretoken/Chart.yaml").open(encoding="utf-8") as source:
    chart = yaml.safe_load(source)

oci_version = platform_version_for(python_version)
chart_version = str(chart.get("version", ""))
app_version = str(chart.get("appVersion", ""))
if chart_version != oci_version or app_version != oci_version:
    raise SystemExit(
        "release versions disagree: "
        f"pyproject.toml={python_version}, expected Chart version/appVersion={oci_version}, "
        f"found version={chart_version}, appVersion={app_version}"
    )
images = [
    environment_image_reference(sys.argv[2], oci_version, component)
    for component in ("control-plane", "frontend", "model-server", "model-server-metax")
]
print(python_version, oci_version, *images)
PY
  )

  IFS=',' read -r -a SELECTED_COMPONENTS <<<"$COMPONENTS"
  for component in "${SELECTED_COMPONENTS[@]}"; do
    case "$component" in
      control-plane | frontend | model-server | model-server-metax | chart) ;;
      *)
        printf 'unknown component: %s\n' "$component" >&2
        exit 2
        ;;
    esac
  done

  OUTPUT_DIR=$("$PYTHON" -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve())' "$OUTPUT_DIR")
  APPLICATION_PACKAGE="$OUTPUT_DIR/foretoken-applications-$OCI_VERSION-linux-amd64.tar.gz"
  CHART_PACKAGE="$OUTPUT_DIR/foretoken-$OCI_VERSION.tgz"
  OCI_REVISION=
  if [[ "$MODE" == build ]] && images_selected && \
    [[ "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null || true)" == "$ROOT" ]]; then
    OCI_REVISION=$(git -C "$ROOT" rev-parse --verify HEAD 2>/dev/null || true)
  fi

  printf 'Release: Python %s, OCI/Chart %s\n' "$PYTHON_VERSION" "$OCI_VERSION"
  printf 'Mode: %s\n' "$MODE"

  if [[ "$MODE" == build || "$MODE" == export ]]; then
    build_or_export
  else
    push_release
  fi
}

# build_or_export owns environment image, application archive, and chart creation.
build_or_export() {
  export DOCKER_DEFAULT_PLATFORM=linux/amd64
  images_selected && require_command make
  if [[ "$MODE" == build ]] && selected chart; then
    require_command helm
  fi
  if images_selected && [[ "$DRY_RUN" != true ]]; then
    require_command docker
    # Retain the selected builder's caches and access to local base images.
    local inspection selection builder driver
    inspection=$(docker buildx inspect)
    selection=$("$PYTHON" -c '
import sys
lines = sys.stdin.read().splitlines()
selected = []
for key in ("Name:", "Driver:"):
    selected.append(next(line.removeprefix(key).strip() for line in lines if line.startswith(key)))
print(*selected)
' <<< "$inspection")
    read -r builder driver <<< "$selection"
    BUILD_DRIVER=$driver
    # docker build requires an explicit selection even after buildx use.
    export BUILDX_BUILDER="$builder"
  fi

  if [[ "$MODE" == build ]]; then
    if selected control-plane; then
      build_with_cache control-plane environment image-control-plane \
        "CONTROL_PLANE_IMAGE=$CONTROL_PLANE_IMAGE" "IMAGE_TARGET=environment" "IMAGE_OUTPUT=type=docker" \
        "OCI_SOURCE=$SOURCE_URL" \
        "OCI_REVISION=$OCI_REVISION"
    fi
    if selected frontend; then
      build_with_cache frontend environment image-frontend \
        "FRONTEND_IMAGE=$FRONTEND_IMAGE" "IMAGE_TARGET=environment" "IMAGE_OUTPUT=type=docker" \
        "OCI_SOURCE=$SOURCE_URL" \
        "OCI_REVISION=$OCI_REVISION"
    fi
    if selected model-server; then
      build_model_server \
        "$MODEL_SERVER_IMAGE" \
        "${INFERENCE_ENGINE_IMAGE:-}" \
        "${FORETOKEN_VLLM_PYTHON:-}"
    fi
    if selected model-server-metax; then
      if [[ "$DRY_RUN" != true && -z "${METAX_INFERENCE_ENGINE_IMAGE:-}" ]]; then
        printf '%s\n' 'METAX_INFERENCE_ENGINE_IMAGE is required for model-server-metax' >&2
        exit 2
      fi
      build_model_server \
        "$MODEL_SERVER_METAX_IMAGE" \
        "${METAX_INFERENCE_ENGINE_IMAGE:-METAX_INFERENCE_ENGINE_IMAGE}" \
        "${METAX_VLLM_PYTHON:-}" model-server-metax
    fi
  fi
  # A release archive contains all applications; partial environment builds skip it.
  if selected control-plane && selected frontend && { selected model-server || selected model-server-metax; }; then
    run mkdir -p "$OUTPUT_DIR"
    if [[ "$DRY_RUN" == true ]]; then
      PAYLOAD_DIR="$OUTPUT_DIR/application-payload"
    else
      PAYLOAD_DIR=$(mktemp -d "$OUTPUT_DIR/application.XXXXXX")
    fi
    build_with_cache control-plane source-export image-control-plane "IMAGE_TARGET=source-export" \
      "IMAGE_OUTPUT=type=local,dest=$PAYLOAD_DIR/control-plane"
    build_with_cache frontend source-export image-frontend "IMAGE_TARGET=source-export" \
      "IMAGE_OUTPUT=type=local,dest=$PAYLOAD_DIR/frontend"
    build_with_cache model-server source-export image-model-server "IMAGE_TARGET=source-export" \
      "IMAGE_OUTPUT=type=local,dest=$PAYLOAD_DIR/model-server"
    run "$PYTHON" - "$PAYLOAD_DIR" "$APPLICATION_PACKAGE" <<'PY'
from pathlib import Path
import sys
import tarfile

payload, output = map(Path, sys.argv[1:])
with tarfile.open(output, "w:gz") as archive:
    for component in ("control-plane", "frontend", "model-server"):
        archive.add(payload / component, arcname=component)
print(f"Application release asset: {output}")
PY
  fi
  if [[ "$MODE" == build ]] && selected chart; then
    run mkdir -p "$OUTPUT_DIR"
    if [[ "$DRY_RUN" == true ]]; then
      run helm package "$ROOT/deploy/charts/foretoken" --destination "$OUTPUT_DIR"
    else
      # Published chart defaults select the matching ordinary GitHub Release asset.
      # The checkout remains usable with already-published image-only releases.
      chart_root=$(mktemp -d "$OUTPUT_DIR/chart.XXXXXX")
      cp -R "$ROOT/deploy/charts/foretoken" "$chart_root/foretoken"
      "$PYTHON" - "$ROOT" "$chart_root/foretoken/values.yaml" "$SOURCE_URL" "$PYTHON_VERSION" "$OCI_VERSION" "$REGISTRY" <<'PY'
from pathlib import Path
import sys
import yaml
sys.path.insert(0, str(Path(sys.argv[1]) / "cli"))
from foretoken import environment_image_reference
path = Path(sys.argv[2])
source, python_version, version, registry = sys.argv[3:]
values = yaml.safe_load(path.read_text())
values["applicationFiles"]["releaseURL"] = f"{source}/releases/download/v{python_version}/foretoken-applications-{version}-linux-amd64.tar.gz"
values["image"]["repository"] = environment_image_reference(registry, version, "control-plane").rsplit(":", 1)[0]
values["frontend"]["image"] = environment_image_reference(registry, version, "frontend")
values["runtime"]["vllm"]["image"] = "auto"
values["runtime"]["vllm"]["environmentImages"] = {
    "nvidia": environment_image_reference(registry, version, "model-server"),
    "metax": environment_image_reference(registry, version, "model-server-metax"),
}
path.write_text(yaml.safe_dump(values, sort_keys=False))
PY
      helm package "$chart_root/foretoken" --destination "$OUTPUT_DIR"
      rm -rf "$chart_root"
    fi
  fi
}

# push_release owns immutable remote-tag checks and OCI publication.
push_release() {
  images_selected && require_command docker
  selected chart && require_command helm

  selected control-plane && push_image "$CONTROL_PLANE_IMAGE"
  selected frontend && push_image "$FRONTEND_IMAGE"
  selected model-server && push_image "$MODEL_SERVER_IMAGE"
  selected model-server-metax && push_image "$MODEL_SERVER_METAX_IMAGE"

  for component in "${SELECTED_COMPONENTS[@]}"; do
    [[ "$component" == chart ]] || push_build_cache "$component" environment
  done
  for component in control-plane frontend model-server; do
    if selected "$component" || { [[ "$component" == model-server ]] && selected model-server-metax; }; then
      push_build_cache "$component" source-export
    fi
  done

  if selected chart; then
    CHART_REGISTRY="oci://$REGISTRY/charts"
    CHART_NAME=foretoken
    if [[ "$DRY_RUN" == true ]]; then
      push_chart "$CHART_REGISTRY"
    else
      set +e
      chart_output=$(show_remote_chart "$CHART_REGISTRY/$CHART_NAME" 2>&1)
      chart_status=$?
      set -e
      if ((chart_status == 0)); then
        printf 'Remote tag already exists, leaving unchanged: %s/%s:%s\n' "$CHART_REGISTRY" "$CHART_NAME" "$OCI_VERSION"
      elif [[ "$chart_output" == *"manifest unknown"* || \
        "$chart_output" == *"failed to perform"*"FetchReference"*": not found"* ]]; then
        [[ -f "$CHART_PACKAGE" ]] || {
          printf 'chart package not found: %s\n' "$CHART_PACKAGE" >&2
          exit 1
        }
        push_chart "$CHART_REGISTRY"
      else
        printf 'cannot determine whether chart exists: %s/%s:%s\n%s\n' \
          "$CHART_REGISTRY" "$CHART_NAME" "$OCI_VERSION" "$chart_output" >&2
        exit 1
      fi
    fi
  fi
}

usage() {
  cat <<'EOF'
Prepare one version of the Foretoken release artifacts.

Usage:
  deploy/release-artifacts build  --registry REGISTRY [options]
  deploy/release-artifacts export [options]
  deploy/release-artifacts push   --registry REGISTRY [options]

Modes:
  build   Build environments, export applications and build caches, and package the chart.
  export  Export applications and their build caches without building environment images.
  push    Push environments, exported build caches and chart, preserving existing tags.

Build and export keep their outputs local. Push requires Docker, Helm for charts,
and ORAS for build caches. Upload the application tar.gz as a GitHub Release asset.

Options:
  --registry REGISTRY       Image prefix, for example ghcr.io/example/foretoken.
  --components LIST         Environment/chart selection for build or push. Defaults to all:
                            control-plane,frontend,model-server,
                            model-server-metax,chart
  --output-dir DIRECTORY    Release artifact directory (default: /tmp/foretoken-release).
  --dry-run                 Print commands for supplementary parsing only.
  --plain-http              Allow a local HTTP registry for artifact publication.
  -h, --help                Show this help.

Build inputs:
  INFERENCE_ENGINE_IMAGE       Override deploy/inference-engines/vllm/source-environment.json.
  METAX_INFERENCE_ENGINE_IMAGE  Compatible MetaX inference runtime image.

Optional inputs such as FORETOKEN_VLLM_PYTHON, METAX_VLLM_PYTHON, registry
mirrors, and language package indexes are forwarded through the existing
Makefile image targets. The release version is read from pyproject.toml and
Chart.yaml; the command stops if their PEP 440 and SemVer forms disagree.
GPU validation is a separate release qualification step and is not run here.
EOF
}

selected() {
  local wanted=$1 component
  for component in "${SELECTED_COMPONENTS[@]}"; do
    [[ "$component" != "$wanted" ]] || return 0
  done
  return 1
}

images_selected() {
  selected control-plane || selected frontend || selected model-server || selected model-server-metax
}

run() {
  printf '+'
  printf ' %q' "$@"
  printf '\n'
  [[ "$DRY_RUN" == true ]] || "$@"
}

require_command() {
  [[ "$DRY_RUN" == true ]] || command -v "$1" >/dev/null || {
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  }
}

# Release only resources created by this invocation, retaining the original failure.
cleanup() {
  local status=$? cleanup_status=0
  trap - EXIT
  if [[ -n "$PAYLOAD_DIR" && "$DRY_RUN" != true ]]; then
    rm -rf -- "$PAYLOAD_DIR" || cleanup_status=$?
  fi
  if [[ -n "$CACHE_EXPORT" && "$DRY_RUN" != true ]]; then
    rm -rf -- "$CACHE_EXPORT" || cleanup_status=$?
  fi
  if ((status == 0)); then status=$cleanup_status; fi
  exit "$status"
}

# Keep the previous cache readable during the solve, then replace it with this target's exported graph.
build_with_cache() {
  local component=$1 target=$2
  shift 2
  local layout="$OUTPUT_DIR/cache/$OCI_VERSION/$component/$target"
  # Model-server callers pass the selected variant's Python explicitly to Make.
  local -a args=(env -u FORETOKEN_VLLM_PYTHON make -C "$ROOT" "$@")
  if [[ "$BUILD_DRIVER" == docker ]]; then
    if [[ "$target" == environment ]]; then
      args+=("BUILDKIT_INLINE_CACHE=1" "IMAGE_OUTPUT=")
    fi
    run "${args[@]}" "IMAGE_CACHE_TO="
    if [[ "$DRY_RUN" != true ]]; then rm -rf -- "$layout"; fi
    return
  fi
  if [[ -z "${IMAGE_CACHE_FROM:-}" && -f "$layout/index.json" ]]; then
    args+=("IMAGE_CACHE_FROM=type=local,src=$layout")
  fi
  if [[ "$DRY_RUN" == true ]]; then
    run "${args[@]}" "IMAGE_CACHE_TO=type=local,dest=$layout,mode=max,image-manifest=true,oci-mediatypes=true"
    return
  fi
  mkdir -p "${layout%/*}"
  CACHE_EXPORT=$(mktemp -d "${layout%/*}/.$target.XXXXXX")
  run "${args[@]}" "IMAGE_CACHE_TO=type=local,dest=$CACHE_EXPORT,mode=max,image-manifest=true,oci-mediatypes=true"
  # A successful metadata-only solve has no index; replace any older graph too.
  rm -rf -- "$layout"
  mv -- "$CACHE_EXPORT" "$layout"
  CACHE_EXPORT=
}

# Publish the native cache layout without rebuilding or changing the build command's local-only behavior.
push_build_cache() {
  local component=$1 target=$2 reference digest output status
  local layout="$OUTPUT_DIR/cache/$OCI_VERSION/$component/$target"
  # Metadata-only targets have no BuildKit cache records to export.
  if [[ "$DRY_RUN" != true && ! -f "$layout/index.json" ]]; then
    printf 'No exported build-cache graph for %s/%s; skipping cache publication\n' "$component" "$target"
    return
  fi
  reference=$("$PYTHON" - "$ROOT" "$REGISTRY" "$OCI_VERSION" "$component" "$target" <<'PY'
import sys
sys.path.insert(0, sys.argv[1] + "/cli")
from foretoken import build_cache_reference
print(build_cache_reference(*sys.argv[2:]))
PY
  )
  require_command oras
  local connection=
  [[ "$PLAIN_HTTP" != true ]] || connection=--plain-http
  if [[ "$DRY_RUN" != true ]]; then
    if output=$(oras resolve ${connection:+"$connection"} "$reference" 2>&1); then
      printf 'Remote tag already exists, leaving unchanged: %s\n' "$reference"
      return
    else
      status=$?
      if [[ "$output" != *"not found"* && "$output" != *"MANIFEST_UNKNOWN"* && "$output" != *"manifest unknown"* ]]; then
        printf 'cannot determine whether build cache exists: %s\n%s\n' "$reference" "$output" >&2
        return "$status"
      fi
    fi
    digest=$("$PYTHON" - "$layout/index.json" <<'PY'
import json
import sys
from pathlib import Path
index = json.loads(Path(sys.argv[1]).read_text())
print(index["manifests"][0]["digest"])
PY
    )
  else
    digest=MANIFEST_DIGEST
  fi
  connection=
  [[ "$PLAIN_HTTP" != true ]] || connection=--to-plain-http
  run oras cp --from-oci-layout ${connection:+"$connection"} "$layout@$digest" "$reference"
}

# Build one model-server variant without replacing an inference base's Python selection.
build_model_server() {
  local image=$1 inference_engine_image=$2 python_path=$3 component=${4:-model-server}
  local -a args=(image-model-server "MODEL_SERVER_IMAGE=$image")
  [[ -z "$inference_engine_image" ]] || args+=("INFERENCE_ENGINE_IMAGE=$inference_engine_image")
  [[ -z "$python_path" ]] || args+=("FORETOKEN_VLLM_PYTHON=$python_path")
  args+=("OCI_SOURCE=$SOURCE_URL" "OCI_REVISION=$OCI_REVISION" "IMAGE_TARGET=environment" "IMAGE_OUTPUT=type=docker")
  build_with_cache "$component" environment "${args[@]}"
}

show_remote_chart() {
  if [[ "$PLAIN_HTTP" == true ]]; then
    helm show chart "$1" --version "$OCI_VERSION" --plain-http
  else
    helm show chart "$1" --version "$OCI_VERSION"
  fi
}

push_chart() {
  if [[ "$PLAIN_HTTP" == true ]]; then
    run helm push "$CHART_PACKAGE" "$1" --plain-http
  else
    run helm push "$CHART_PACKAGE" "$1"
  fi
}

# Preserve published version tags while allowing a partial release to resume.
push_image() {
  local image=$1 output status
  if [[ "$DRY_RUN" == true ]]; then
    run docker push "$image"
    return
  fi
  set +e
  output=$(inspect_remote_image "$image" 2>&1)
  status=$?
  set -e
  if ((status == 0)); then
    printf 'Remote tag already exists, leaving unchanged: %s\n' "$image"
    return
  fi
  if [[ "$output" != *"manifest unknown"* && "$output" != *"no such manifest"* ]]; then
    printf 'cannot determine whether image exists: %s\n%s\n' "$image" "$output" >&2
    return 1
  fi
  run docker push "$image"
}

inspect_remote_image() {
  if [[ "$PLAIN_HTTP" == true ]]; then
    docker manifest inspect --insecure "$1"
  else
    docker manifest inspect "$1"
  fi
}

main "$@"
