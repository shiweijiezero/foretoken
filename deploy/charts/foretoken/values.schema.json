{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "imagePullSecrets",
    "controller",
    "workload",
    "frontend",
    "observability",
    "runtime"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "controller": {
      "type": "object",
      "required": [
        "replicas",
        "autoscalingTelemetry"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "autoscalingTelemetry": {
          "type": "object",
          "required": [
            "collectionTimeout",
            "requestTimeout",
            "concurrency"
          ],
          "properties": {
            "collectionTimeout": {
              "type": "string",
              "minLength": 1
            },
            "requestTimeout": {
              "type": "string",
              "minLength": 1
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "required": [
        "imagePullSecrets"
      ],
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "frontend": {
      "type": "object",
      "required": [
        "enabled",
        "mode",
        "image",
        "port",
        "gateway"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "local",
            "gateway"
          ]
        },
        "image": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "gateway": {
          "type": "object",
          "required": [
            "create",
            "controllerName",
            "name",
            "namespace",
            "sectionName"
          ],
          "properties": {
            "create": {
              "type": "boolean"
            },
            "controllerName": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "sectionName": {
              "type": "string"
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "enabled",
            "disabled"
          ]
        },
        "additionalLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "vllm"
      ],
      "properties": {
        "vllm": {
          "type": "object",
          "required": [
            "image",
            "profileRevision",
            "modelServerPort",
            "gpu"
          ],
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            },
            "profileRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "modelServerPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "gpu": {
              "type": "object",
              "required": [
                "resourceName",
                "nodeSelector"
              ],
              "properties": {
                "resourceName": {
                  "type": "string",
                  "minLength": 1
                },
                "runtimeClassName": {
                  "type": "string"
                },
                "nodeSelector": {
                  "type": "object",
                  "required": [
                    "key",
                    "value"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "ec": {
              "type": "object",
              "required": [
                "profileName",
                "profileRevision",
                "connector",
                "sharedStorageClaim",
                "sharedStoragePath"
              ],
              "properties": {
                "profileName": {
                  "type": "string"
                },
                "profileRevision": {
                  "type": "string"
                },
                "connector": {
                  "type": "string"
                },
                "sharedStorageClaim": {
                  "type": "string"
                },
                "sharedStoragePath": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "profileName": {
                        "minLength": 1
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "profileRevision": {
                        "minLength": 1
                      },
                      "connector": {
                        "const": "ECExampleConnector"
                      },
                      "sharedStorageClaim": {
                        "minLength": 1
                      },
                      "sharedStoragePath": {
                        "minLength": 1
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "profileRevision": {
                        "const": ""
                      },
                      "connector": {
                        "const": "ECExampleConnector"
                      },
                      "sharedStorageClaim": {
                        "const": ""
                      }
                    }
                  }
                }
              ]
            },
            "pd": {
              "type": "object",
              "required": [
                "profileName",
                "profileRevision",
                "protocol",
                "bootstrapPort",
                "abortRequestTimeoutSeconds",
                "rdmaDeviceName",
                "rdmaResourceName",
                "rdmaResourceCount"
              ],
              "properties": {
                "profileName": {
                  "type": "string"
                },
                "profileRevision": {
                  "type": "string"
                },
                "protocol": {
                  "type": "string"
                },
                "bootstrapPort": {
                  "type": "integer"
                },
                "abortRequestTimeoutSeconds": {
                  "type": "integer"
                },
                "rdmaDeviceName": {
                  "type": "string"
                },
                "rdmaResourceName": {
                  "type": "string"
                },
                "rdmaResourceCount": {
                  "type": "integer"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "profileName": {
                        "minLength": 1
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "profileRevision": {
                        "minLength": 1
                      },
                      "protocol": {
                        "const": "rdma"
                      },
                      "bootstrapPort": {
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "abortRequestTimeoutSeconds": {
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      "rdmaDeviceName": {
                        "minLength": 1
                      },
                      "rdmaResourceName": {
                        "minLength": 1
                      },
                      "rdmaResourceCount": {
                        "minimum": 1,
                        "maximum": 2147483647
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "profileRevision": {
                        "const": ""
                      },
                      "protocol": {
                        "const": ""
                      },
                      "bootstrapPort": {
                        "const": 0
                      },
                      "abortRequestTimeoutSeconds": {
                        "const": 0
                      },
                      "rdmaDeviceName": {
                        "const": ""
                      },
                      "rdmaResourceName": {
                        "const": ""
                      },
                      "rdmaResourceCount": {
                        "const": 0
                      }
                    }
                  }
                }
              ]
            },
            "mooncakeStore": {
              "type": "object",
              "required": [
                "profileName",
                "profileRevision",
                "configMapName",
                "configMapKey",
                "pythonHashSeed"
              ],
              "properties": {
                "profileName": {
                  "type": "string"
                },
                "profileRevision": {
                  "type": "string"
                },
                "configMapName": {
                  "type": "string"
                },
                "configMapKey": {
                  "type": "string"
                },
                "pythonHashSeed": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "profileName": {
                        "minLength": 1
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "profileRevision": {
                        "minLength": 1
                      },
                      "configMapName": {
                        "minLength": 1
                      },
                      "configMapKey": {
                        "minLength": 1
                      },
                      "pythonHashSeed": {
                        "minLength": 1
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "profileRevision": {
                        "const": ""
                      },
                      "configMapName": {
                        "const": ""
                      },
                      "configMapKey": {
                        "const": ""
                      },
                      "pythonHashSeed": {
                        "const": ""
                      }
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "frontend": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "frontend": {
            "properties": {
              "image": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "frontend": {
            "properties": {
              "enabled": {
                "const": true
              },
              "mode": {
                "const": "gateway"
              },
              "gateway": {
                "properties": {
                  "create": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "frontend": {
            "properties": {
              "gateway": {
                "properties": {
                  "name": {
                    "minLength": 1
                  },
                  "namespace": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "frontend": {
            "properties": {
              "enabled": {
                "const": true
              },
              "mode": {
                "const": "gateway"
              },
              "gateway": {
                "properties": {
                  "create": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "frontend": {
            "properties": {
              "gateway": {
                "properties": {
                  "controllerName": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
