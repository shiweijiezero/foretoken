{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "image",
    "imagePullSecrets",
    "controller",
    "workload",
    "loadBalancer",
    "rdma",
    "frontend",
    "observability",
    "runtime"
  ],
  "properties": {
    "profiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nsightViewerImage", "viewerProxyImage"],
      "properties": {
        "nsightViewerImage": {"type": "string"},
        "viewerProxyImage": {"type": "string", "minLength": 1}
      }
    },
    "rdma": {
      "type": "object",
      "required": ["managed", "image", "nodeNames", "resourceName", "resourceCount"],
      "properties": {
        "resourceName": {"type": "string"},
        "resourceCount": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "managed": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "nodeNames": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object",
      "required": [
        "imageRegistry"
      ],
      "properties": {
        "imageRegistry": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "controller": {
      "type": "object",
      "required": [
        "replicas",
        "autoscalingTelemetry"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "autoscalingTelemetry": {
          "type": "object",
          "required": [
            "collectionTimeout",
            "requestTimeout",
            "concurrency"
          ],
          "properties": {
            "collectionTimeout": {
              "type": "string",
              "minLength": 1
            },
            "requestTimeout": {
              "type": "string",
              "minLength": 1
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "required": [
        "imagePullSecrets",
        "cache"
      ],
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "cache": {
          "type": "object",
          "required": [
            "claimName",
            "mountPath"
          ],
          "properties": {
            "claimName": {
              "type": "string"
            },
            "mountPath": {
              "type": "string",
              "pattern": "^/",
              "minLength": 2
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "loadBalancer": {
      "type": "object",
      "required": [
        "managedAddresses"
      ],
      "properties": {
        "managedAddresses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "frontend": {
      "type": "object",
      "required": [
        "enabled",
        "mode",
        "image",
        "port",
        "gateway"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "local",
            "gateway"
          ]
        },
        "image": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "gateway": {
          "type": "object",
          "required": [
            "create",
            "controllerName",
            "name",
            "namespace",
            "sectionName"
          ],
          "properties": {
            "create": {
              "type": "boolean"
            },
            "controllerName": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "sectionName": {
              "type": "string"
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "enabled",
            "disabled"
          ]
        },
        "additionalLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "prometheus": {
          "type": "string"
        },
        "notifications": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string"
            },
            "additionalLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "slack": {
              "type": "object",
              "properties": {
                "webhookSecret": {
                  "type": "object",
                  "required": ["name", "key"],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "vllm"
      ],
      "properties": {
        "vllmOmni": {
          "type": "object",
          "required": ["image"],
          "properties": {
            "image": {"type": "string"}
          },
          "additionalProperties": false
        },
        "vllm": {
          "type": "object",
          "required": [
            "image",
            "profileRevision",
            "modelServerPort",
            "gpu",
            "modelSource"
          ],
          "properties": {
            "image": {
              "type": "string"
            },
            "nsightImage": {
              "type": "string"
            },
            "profileRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "modelServerPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "gpu": {
              "type": "object",
              "required": [
                "resourceName",
                "nodeSelector"
              ],
              "properties": {
                "resourceName": {
                  "type": "string",
                  "minLength": 1
                },
                "runtimeClassName": {
                  "type": "string"
                },
                "nodeSelector": {
                  "type": "object",
                  "required": [
                    "key",
                    "value"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "ec": {
              "type": "object",
              "required": [
                "profileName",
                "profileRevision",
                "connector",
                "sharedStorageClaim",
                "sharedStoragePath"
              ],
              "properties": {
                "profileName": {
                  "type": "string"
                },
                "profileRevision": {
                  "type": "string"
                },
                "connector": {
                  "type": "string"
                },
                "sharedStorageClaim": {
                  "type": "string"
                },
                "sharedStoragePath": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "profileName": {
                        "minLength": 1
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "sharedStorageClaim": {
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            },
            "pd": {
              "type": "object",
              "required": [
                "protocol",
                "bootstrapPort",
                "abortRequestTimeoutSeconds",
                "rdmaDeviceName"
              ],
              "properties": {
                "protocol": {
                  "type": "string",
                  "enum": [
                    "rdma",
                    "tcp"
                  ]
                },
                "bootstrapPort": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "abortRequestTimeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "rdmaDeviceName": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "mooncakeStore": {
              "type": "object",
              "required": [
                "profileName",
                "profileRevision",
                "configMapName",
                "configMapKey",
                "pythonHashSeed"
              ],
              "properties": {
                "profileName": {
                  "type": "string"
                },
                "profileRevision": {
                  "type": "string"
                },
                "configMapName": {
                  "type": "string"
                },
                "configMapKey": {
                  "type": "string"
                },
                "pythonHashSeed": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "profileName": {
                        "minLength": 1
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "profileRevision": {
                        "minLength": 1
                      },
                      "configMapName": {
                        "minLength": 1
                      },
                      "configMapKey": {
                        "minLength": 1
                      },
                      "pythonHashSeed": {
                        "minLength": 1
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "profileRevision": {
                        "const": ""
                      },
                      "configMapName": {
                        "const": ""
                      },
                      "configMapKey": {
                        "const": ""
                      },
                      "pythonHashSeed": {
                        "const": ""
                      }
                    }
                  }
                }
              ]
            },
            "modelSource": {
              "type": "object",
              "required": [
                "endpoint",
                "tokenSecret"
              ],
              "properties": {
                "endpoint": {
                  "type": "string"
                },
                "tokenSecret": {
                  "type": "object",
                  "required": [
                    "name",
                    "key"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "frontend": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "frontend": {
            "properties": {
              "image": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "frontend": {
            "properties": {
              "enabled": {
                "const": true
              },
              "mode": {
                "const": "gateway"
              },
              "gateway": {
                "properties": {
                  "create": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "frontend": {
            "properties": {
              "gateway": {
                "properties": {
                  "name": {
                    "minLength": 1
                  },
                  "namespace": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "frontend": {
            "properties": {
              "enabled": {
                "const": true
              },
              "mode": {
                "const": "gateway"
              },
              "gateway": {
                "properties": {
                  "create": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "frontend": {
            "properties": {
              "gateway": {
                "properties": {
                  "controllerName": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
