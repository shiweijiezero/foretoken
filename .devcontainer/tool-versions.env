# Foretoken devcontainer tool defaults.
#
# These are pinned for reproducible team environments. Override any value from
# your local environment before rebuilding the devcontainer when testing a new
# tool version.

KIND_VERSION=v0.30.0
KUBEBUILDER_VERSION=4.14.0
KUBECTL_VERSION=v1.35.0
RUSTUP_INIT_URL=https://sh.rustup.rs
RUSTUP_DIRECT_BASE_URL=https://static.rust-lang.org/rustup/dist
USE_TUNA_APT_MIRROR=false
